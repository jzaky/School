// AEGIS schema. Every tenant table carries orgId and is protected by RLS (prisma/rls.sql).
// Enums are kept in PostgreSQL so constraints hold even for raw SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

// ---------- Identity ----------

enum UserStatus {
  active
  disabled
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique
  name            String
  passwordHash    String?    @map("password_hash")
  mfaSecretEnc    String?    @map("mfa_secret_enc")
  /// Last accepted TOTP time step: a code is accepted once.
  mfaLastStep     BigInt?    @map("mfa_last_step")
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  status          UserStatus @default(active)
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions    Session[]
  memberships Membership[]

  @@map("users")
}

model Session {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  activeOrgId String?   @map("active_org_id") @db.Uuid
  /// Set for single sign-on sessions: the session may act only in the organization whose identity provider issued it.
  ssoOrgId    String?   @map("sso_org_id") @db.Uuid
  mfaPassed   Boolean   @default(false) @map("mfa_passed")
  /// Wrong MFA codes entered in this session; the session is revoked at the limit.
  mfaFailures Int       @default(0) @map("mfa_failures")
  ip          String?
  userAgent   String?   @map("user_agent")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------- Organizations ----------

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  plan      String   @default("enterprise_trial")
  /// End of a trial plan. Null for paid plans and for trials without an end date.
  trialEndsAt DateTime? @map("trial_ends_at")
  demoMode  Boolean  @default(false) @map("demo_mode")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

enum MembershipStatus {
  active
  invited
  suspended
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  key         String
  name        String
  description String   @default("")
  permissions String[] @default([])
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@unique([orgId, key])
  @@index([orgId])
  @@map("roles")
}

model Membership {
  id        String           @id @default(uuid(7)) @db.Uuid
  orgId     String           @map("org_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(active)
  title     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("memberships")
}

model Team {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  key         String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members TeamMember[]

  @@unique([orgId, key])
  @@index([orgId])
  @@map("teams")
}

model TeamMember {
  id           String   @id @default(uuid(7)) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  isLead       Boolean  @default(false) @map("is_lead")
  createdAt    DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@index([orgId])
  @@map("team_members")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  email      String
  roleId     String    @map("role_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([orgId])
  @@map("invitations")
}

model SsoConnection {
  id              String   @id @default(uuid(7)) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  /// "oidc" or "saml".
  protocol        String   @default("oidc")
  issuer          String
  clientId        String   @map("client_id")
  clientSecretEnc String   @map("client_secret_enc")
  /// SAML: the identity provider's single sign-on URL and signing certificate (PEM or base64 body).
  samlEntryPoint  String?  @map("saml_entry_point")
  samlIdpCert     String?  @map("saml_idp_cert")
  emailDomains    String[] @default([]) @map("email_domains")
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([orgId])
  @@map("sso_connections")
}

enum ApiKeySubject {
  agent
  integration
  user
}

model ApiKey {
  id          String        @id @default(uuid(7)) @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  name        String
  prefix      String        @unique
  keyHash     String        @unique @map("key_hash")
  subjectType ApiKeySubject @map("subject_type")
  subjectId   String        @map("subject_id") @db.Uuid
  scopes      String[]      @default([])
  expiresAt   DateTime?     @map("expires_at")
  revokedAt   DateTime?     @map("revoked_at")
  lastUsedAt  DateTime?     @map("last_used_at")
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([orgId])
  @@index([subjectType, subjectId])
  @@map("api_keys")
}

// ---------- Agent registry ----------

enum AgentStatus {
  draft
  registered
  active
  suspended
  revoked
  archived
}

enum Environment {
  development
  staging
  production
}

enum DataClassification {
  public
  internal
  confidential
  restricted
}

model Agent {
  id                      String             @id @default(uuid(7)) @db.Uuid
  orgId                   String             @map("org_id") @db.Uuid
  slug                    String
  name                    String
  description             String             @default("")
  status                  AgentStatus        @default(draft)
  environment             Environment        @default(development)
  modelProvider           String             @default("") @map("model_provider")
  modelId                 String             @default("") @map("model_id")
  /// The registered model this agent runs on (docs/MODEL_DATA_GOVERNANCE.md). Null: not linked to the model registry.
  modelRecordId           String?            @map("model_record_id") @db.Uuid
  businessOwnerId         String?            @map("business_owner_id") @db.Uuid
  technicalOwnerId        String?            @map("technical_owner_id") @db.Uuid
  teamId                  String?            @map("team_id") @db.Uuid
  dataClassificationLimit DataClassification @default(internal) @map("data_classification_limit")
  riskTier                String             @default("medium") @map("risk_tier")
  /// What the agent is for, in business terms. Shown to approvers and used for objective alignment.
  purpose                 String             @default("")
  /// Managed autonomy level 0 to 4 enforced by the gateway (docs/MANAGED_AUTONOMY.md). 4 applies policy as written.
  autonomyLevel           Int                @default(4) @map("autonomy_level")
  /// Largest amount the agent may act on without a person at levels 2 and 3 (organization currency). Null: amount-bearing actions need approval at level 2.
  autonomyCeilingAmount   Decimal?           @map("autonomy_ceiling_amount") @db.Decimal(18, 2)
  autonomyChangedAt       DateTime?          @map("autonomy_changed_at")
  /// Domains this agent may send data or requests to, across all its tools. Empty means only the tools' own rules apply.
  allowedDestinations     String[]           @default([]) @map("allowed_destinations")
  /// After this time the agent's authority lapses until someone re-certifies it. Null means no expiry.
  credentialExpiresAt     DateTime?          @map("credential_expires_at")
  currentVersion          Int                @default(1) @map("current_version")
  metadata                Json               @default("{}")
  /// A temporary clone made by the Attack Simulation Lab. Lab agents are kept out of agent lists, counts,
  /// monitoring alerts, incidents and notifications; their requests stay on the evidence record.
  isLab                   Boolean            @default(false) @map("is_lab")
  statusReason            String?            @map("status_reason")
  statusChangedAt         DateTime?          @map("status_changed_at")
  lastActivityAt          DateTime?          @map("last_activity_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  versions            AgentVersion[]
  tools               AgentTool[]
  permissions         Permission[]
  requests            ActionRequest[]
  delegationsGiven    AgentDelegation[] @relation("delegator")
  delegationsReceived AgentDelegation[] @relation("delegate")

  @@unique([orgId, slug])
  @@index([orgId, status])
  @@map("agents")
}

/// One agent lets another act on its behalf, within a subset of its own tools. The delegate never
/// gains more than the intersection of both agents' grants; both agents' policies apply.
model AgentDelegation {
  id               String    @id @default(uuid(7)) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  delegatorAgentId String    @map("delegator_agent_id") @db.Uuid
  delegateAgentId  String    @map("delegate_agent_id") @db.Uuid
  /// Tool keys the delegate may use on the delegator's behalf. Empty means every tool both agents hold.
  toolKeys         String[]  @default([]) @map("tool_keys")
  /// Numeric caps and other limits applied to delegated requests, for example { "maxAmount": 5000 }.
  constraints      Json      @default("{}")
  reason           String    @default("")
  grantedBy        String?   @map("granted_by") @db.Uuid
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at")

  delegator Agent           @relation("delegator", fields: [delegatorAgentId], references: [id])
  delegate  Agent           @relation("delegate", fields: [delegateAgentId], references: [id])
  requests  ActionRequest[]

  @@index([orgId, delegateAgentId])
  @@index([orgId, delegatorAgentId])
  @@map("agent_delegations")
}

model AgentVersion {
  id         String    @id @default(uuid(7)) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  agentId    String    @map("agent_id") @db.Uuid
  version    Int
  manifest   Json      @default("{}")
  notes      String    @default("")
  deployedAt DateTime? @map("deployed_at")
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([orgId])
  @@map("agent_versions")
}

enum IntegrationStatus {
  active
  disabled
}

model Integration {
  id                     String            @id @default(uuid(7)) @db.Uuid
  orgId                  String            @map("org_id") @db.Uuid
  key                    String
  name                   String
  type                   String
  description            String            @default("")
  baseUrl                String?           @map("base_url")
  status                 IntegrationStatus @default(active)
  statusReason           String?           @map("status_reason")
  webhookSecretEnc       String?           @map("webhook_secret_enc")
  settings               Json              @default("{}")
  lastHealthAt           DateTime?         @map("last_health_at")
  lastHealthOk           Boolean?          @map("last_health_ok")
  /// Last enforcement-path audit: downstream records compared with gateway receipts (see gateway/enforcement.ts).
  lastEnforcementAuditAt DateTime?         @map("last_enforcement_audit_at")
  enforcementSummary     Json              @default("{}") @map("enforcement_summary")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  tools       Tool[]
  credentials Credential[]

  @@unique([orgId, key])
  @@index([orgId])
  @@map("integrations")
}

model Credential {
  id            String    @id @default(uuid(7)) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  integrationId String    @map("integration_id") @db.Uuid
  name          String
  secretEnc     String    @map("secret_enc")
  version       Int       @default(1)
  rotationDueAt DateTime? @map("rotation_due_at")
  rotatedAt     DateTime? @map("rotated_at")
  revokedAt     DateTime? @map("revoked_at")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, name])
  @@index([orgId])
  @@map("credentials")
}

model Tool {
  id                String   @id @default(uuid(7)) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  key               String
  name              String
  description       String   @default("")
  integrationId     String?  @map("integration_id") @db.Uuid
  parameterSchema   Json     @default("{}") @map("parameter_schema")
  destinationRules  Json     @default("{}") @map("destination_rules")
  riskLevel         String   @default("medium") @map("risk_level")
  /// Uncertainty requirements for this tool (docs/UNCERTAINTY_GOVERNANCE.md). Empty: only contradictions escalate.
  uncertaintyPolicy Json     @default("{}") @map("uncertainty_policy")
  /// Rationale requirements for this tool (docs/REASONING_GOVERNANCE.md). Empty: only integrity failures escalate.
  reasoningPolicy   Json     @default("{}") @map("reasoning_policy")
  enabled           Boolean  @default(true)
  disabledReason    String?  @map("disabled_reason")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  integration Integration? @relation(fields: [integrationId], references: [id])
  agentTools  AgentTool[]

  @@unique([orgId, key])
  @@index([orgId])
  @@map("tools")
}

model AgentTool {
  id            String    @id @default(uuid(7)) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  agentId       String    @map("agent_id") @db.Uuid
  toolId        String    @map("tool_id") @db.Uuid
  enabled       Boolean   @default(true)
  revokedAt     DateTime? @map("revoked_at")
  /// Time-limited grants end here; the gateway refuses the tool afterwards.
  expiresAt     DateTime? @map("expires_at")
  revokedReason String?   @map("revoked_reason")
  scope         Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@index([orgId])
  @@map("agent_tools")
}

model Resource {
  id             String             @id @default(uuid(7)) @db.Uuid
  orgId          String             @map("org_id") @db.Uuid
  key            String
  name           String
  type           String
  classification DataClassification @default(internal)
  ownerTeamId    String?            @map("owner_team_id") @db.Uuid
  attributes     Json               @default("{}")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  permissions Permission[]

  @@unique([orgId, key])
  @@index([orgId])
  @@map("resources")
}

model Permission {
  id          String    @id @default(uuid(7)) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  agentId     String    @map("agent_id") @db.Uuid
  resourceId  String    @map("resource_id") @db.Uuid
  actions     String[]  @default([])
  constraints Json      @default("{}")
  grantedBy   String?   @map("granted_by") @db.Uuid
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([agentId, resourceId])
  @@index([orgId])
  @@map("permissions")
}

// ---------- Policy ----------

enum PolicyVersionState {
  draft
  review
  active
  retired
}

model Policy {
  id               String   @id @default(uuid(7)) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  key              String
  name             String
  description      String   @default("")
  category         String   @default("authorization")
  archived         Boolean  @default(false)
  currentVersionId String?  @map("current_version_id") @db.Uuid
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  versions    PolicyVersion[]
  assignments PolicyAssignment[]
  events      PolicyEvent[]

  @@unique([orgId, key])
  @@index([orgId])
  @@map("policies")
}

model PolicyVersion {
  id          String             @id @default(uuid(7)) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  policyId    String             @map("policy_id") @db.Uuid
  version     Int
  document    Json
  contentHash String             @map("content_hash")
  state       PolicyVersionState @default(draft)
  changeNote  String             @default("") @map("change_note")
  createdBy   String?            @map("created_by") @db.Uuid
  approvedBy  String?            @map("approved_by") @db.Uuid
  activatedAt DateTime?          @map("activated_at")
  retiredAt   DateTime?          @map("retired_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([orgId])
  @@map("policy_versions")
}

enum PolicyTargetType {
  agent
  team
  org
}

model PolicyAssignment {
  id         String           @id @default(uuid(7)) @db.Uuid
  orgId      String           @map("org_id") @db.Uuid
  policyId   String           @map("policy_id") @db.Uuid
  targetType PolicyTargetType @map("target_type")
  targetId   String?          @map("target_id") @db.Uuid
  priority   Int              @default(100)
  createdBy  String?          @map("created_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([orgId, targetType, targetId])
  @@map("policy_assignments")
}

model PolicyEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  policyId  String   @map("policy_id") @db.Uuid
  versionId String?  @map("version_id") @db.Uuid
  type      String
  actorId   String?  @map("actor_id") @db.Uuid
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([orgId, policyId])
  @@map("policy_events")
}

// ---------- Gateway ----------

enum ActionRequestStatus {
  evaluating
  allowed
  denied
  pending_approval
  approved
  rejected
  expired
  executing
  executed
  failed
  unknown
  quarantined
  awaiting_information
}

model ActionRequest {
  id                       String              @id @default(uuid(7)) @db.Uuid
  orgId                    String              @map("org_id") @db.Uuid
  agentId                  String              @map("agent_id") @db.Uuid
  toolId                   String?             @map("tool_id") @db.Uuid
  toolKey                  String              @map("tool_key")
  action                   String
  resourceKey              String?             @map("resource_key")
  params                   Json                @default("{}")
  paramsHash               String              @map("params_hash")
  idempotencyKey           String              @map("idempotency_key")
  correlationId            String              @map("correlation_id")
  traceId                  String?             @map("trace_id")
  principalUserId          String?             @map("principal_user_id") @db.Uuid
  principalRef             String?             @map("principal_ref")
  environment              Environment         @default(development)
  status                   ActionRequestStatus @default(evaluating)
  justification            String              @default("")
  riskIndicators           Json                @default("[]") @map("risk_indicators")
  context                  Json                @default("{}")
  expiresAt                DateTime?           @map("expires_at")
  completedAt              DateTime?           @map("completed_at")
  /// Set when a grant is consumed and the downstream call begins. Cleared never: it dates the first attempt.
  executionStartedAt       DateTime?           @map("execution_started_at")
  executionAttempts        Int                 @default(0) @map("execution_attempts")
  /// Stable key handed to the downstream system so repeats of one request are one operation there.
  downstreamIdempotencyKey String?             @map("downstream_idempotency_key")
  /// Set when the request is made under an agent-to-agent delegation; the delegating agent's limits also apply.
  delegationId             String?             @map("delegation_id") @db.Uuid
  onBehalfOfAgentId        String?             @map("on_behalf_of_agent_id") @db.Uuid
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  agent      Agent                   @relation(fields: [agentId], references: [id])
  delegation AgentDelegation?        @relation(fields: [delegationId], references: [id])
  decisions  AuthorizationDecision[]
  approvals  ApprovalRequest[]
  grants     ExecutionGrant[]
  receipts   ExecutionReceipt[]

  @@unique([orgId, idempotencyKey])
  @@index([orgId, status])
  @@index([orgId, agentId, createdAt])
  @@index([orgId, createdAt])
  @@map("action_requests")
}

enum DecisionResult {
  allow
  deny
  require_approval
  /// Allowed with parameters narrowed by policy (caps, removed fields, forced values). Executes the narrowed request.
  restrict
  /// Held for security review. Nothing executes until a reviewer releases it to approval or refuses it.
  quarantine
  /// The agent must resubmit with the named fields before a decision can be made.
  request_more_information
  error
}

model AuthorizationDecision {
  id               String         @id @default(uuid(7)) @db.Uuid
  orgId            String         @map("org_id") @db.Uuid
  actionRequestId  String         @map("action_request_id") @db.Uuid
  result           DecisionResult
  policyVersionIds String[]       @default([]) @map("policy_version_ids") @db.Uuid
  matchedRuleIds   String[]       @default([]) @map("matched_rule_ids")
  explanation      Json           @default("{}")
  evaluator        String         @default("aegis-deterministic")
  inputHash        String         @map("input_hash")
  latencyMs        Int            @default(0) @map("latency_ms")
  /// low, elevated, high or unknown; null for decisions made before uncertainty was assessed or refused before policy.
  uncertaintyLevel String?        @map("uncertainty_level")
  createdAt        DateTime       @default(now()) @map("created_at")

  request ActionRequest @relation(fields: [actionRequestId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([actionRequestId])
  @@map("authorization_decisions")
}

enum ApprovalStatus {
  pending
  approved
  rejected
  expired
  more_info
  escalated
}

model ApprovalRequest {
  id                String         @id @default(uuid(7)) @db.Uuid
  orgId             String         @map("org_id") @db.Uuid
  actionRequestId   String         @map("action_request_id") @db.Uuid
  status            ApprovalStatus @default(pending)
  requiredApprovals Int            @default(1) @map("required_approvals")
  requiredRoles     String[]       @default([]) @map("required_roles")
  assignedUserId    String?        @map("assigned_user_id") @db.Uuid
  escalatedToUserId String?        @map("escalated_to_user_id") @db.Uuid
  requestHash       String         @map("request_hash")
  triggeringRuleId  String?        @map("triggering_rule_id")
  policyVersionId   String?        @map("policy_version_id") @db.Uuid
  reason            String         @default("")
  expiresAt         DateTime       @map("expires_at")
  decidedAt         DateTime?      @map("decided_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  request   ActionRequest      @relation(fields: [actionRequestId], references: [id], onDelete: Cascade)
  responses ApprovalResponse[]

  @@index([orgId, status])
  @@index([actionRequestId])
  @@map("approval_requests")
}

enum ApprovalDecision {
  approve
  reject
  request_info
  escalate
  reassign
  info_provided
}

model ApprovalResponse {
  id                String           @id @default(uuid(7)) @db.Uuid
  orgId             String           @map("org_id") @db.Uuid
  approvalRequestId String           @map("approval_request_id") @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  decision          ApprovalDecision
  comment           String           @default("")
  requestHashSeen   String           @map("request_hash_seen")
  targetUserId      String?          @map("target_user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")

  approval ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([approvalRequestId])
  @@map("approval_responses")
}

model ExecutionGrant {
  id              String    @id @default(uuid(7)) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  actionRequestId String    @map("action_request_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  requestHash     String    @map("request_hash")
  /// The integration whose downstream system may verify this grant. Another integration's key is refused.
  integrationId   String?   @map("integration_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  /// Set when the grant is withdrawn (pause, suspension, revocation, expiry housekeeping). A voided grant never verifies.
  voidedAt        DateTime? @map("voided_at")
  voidReason      String?   @map("void_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  request ActionRequest @relation(fields: [actionRequestId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([actionRequestId])
  @@map("execution_grants")
}

enum ReceiptStatus {
  succeeded
  failed
  skipped
  unknown
}

model ExecutionReceipt {
  id                  String        @id @default(uuid(7)) @db.Uuid
  orgId               String        @map("org_id") @db.Uuid
  actionRequestId     String        @map("action_request_id") @db.Uuid
  status              ReceiptStatus
  downstreamSystem    String        @map("downstream_system")
  downstreamReference String?       @map("downstream_reference")
  responseSummary     Json          @default("{}") @map("response_summary")
  durationMs          Int           @default(0) @map("duration_ms")
  /// Which execution attempt produced this receipt (1 = first call, later numbers = reconciliation or retry).
  attempt             Int           @default(1)
  createdAt           DateTime      @default(now()) @map("created_at")

  request ActionRequest @relation(fields: [actionRequestId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([actionRequestId, createdAt])
  @@map("execution_receipts")
}

// ---------- Evidence and monitoring ----------

model EvidenceEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  seq           BigInt
  type          String
  actorType     String   @map("actor_type")
  actorId       String?  @map("actor_id")
  subjectType   String   @map("subject_type")
  subjectId     String?  @map("subject_id")
  correlationId String?  @map("correlation_id")
  traceId       String?  @map("trace_id")
  payload       Json     @default("{}")
  prevHash      String   @map("prev_hash")
  hash          String
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@unique([orgId, seq])
  @@index([orgId, occurredAt])
  @@index([orgId, type])
  @@index([orgId, correlationId])
  @@index([orgId, subjectType, subjectId])
  @@map("evidence_events")
}

model EvidenceCheckpoint {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  throughSeq BigInt   @map("through_seq")
  hash       String
  signature  String
  keyId      String   @map("key_id")
  signedAt   DateTime @default(now()) @map("signed_at")

  @@unique([orgId, throughSeq])
  @@map("evidence_checkpoints")
}

model MonitoringRule {
  id          String    @id @default(uuid(7)) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  key         String
  name        String
  description String    @default("")
  definition  Json
  severity    String    @default("medium")
  enabled     Boolean   @default(true)
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  alerts Alert[]

  @@unique([orgId, key])
  @@index([orgId])
  @@map("monitoring_rules")
}

enum AlertStatus {
  open
  acknowledged
  resolved
}

model Alert {
  id             String      @id @default(uuid(7)) @db.Uuid
  orgId          String      @map("org_id") @db.Uuid
  ruleId         String?     @map("rule_id") @db.Uuid
  severity       String
  title          String
  detail         Json        @default("{}")
  status         AlertStatus @default(open)
  agentId        String?     @map("agent_id") @db.Uuid
  dedupeKey      String      @map("dedupe_key")
  acknowledgedBy String?     @map("acknowledged_by") @db.Uuid
  resolvedBy     String?     @map("resolved_by") @db.Uuid
  resolvedAt     DateTime?   @map("resolved_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  rule MonitoringRule? @relation(fields: [ruleId], references: [id])

  @@unique([orgId, dedupeKey])
  @@index([orgId, status])
  @@map("alerts")
}

enum EvidenceSource {
  automated
  customer_document
  human_validated
  missing
}

model ControlMapping {
  id           String         @id @default(uuid(7)) @db.Uuid
  orgId        String         @map("org_id") @db.Uuid
  controlId    String         @map("control_id") @db.Uuid
  source       EvidenceSource @default(missing)
  evidenceType String?        @map("evidence_type")
  status       String         @default("not_assessed")
  notes        String         @default("")
  validatedBy  String?        @map("validated_by") @db.Uuid
  validatedAt  DateTime?      @map("validated_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  control Control @relation(fields: [controlId], references: [id])

  @@unique([orgId, controlId])
  @@map("control_mappings")
}

// ---------- Shield ----------

enum DataAction {
  allow
  mask
  redact
  block
  require_approval
}

model DataClass {
  id          String     @id @default(uuid(7)) @db.Uuid
  orgId       String     @map("org_id") @db.Uuid
  key         String
  name        String
  description String     @default("")
  detector    String
  pattern     String?
  action      DataAction @default(mask)
  severity    String     @default("medium")
  enabled     Boolean    @default(true)
  isSystem    Boolean    @default(false) @map("is_system")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([orgId, key])
  @@map("data_classes")
}

enum SecurityEventStatus {
  open
  triaged
  dismissed
  linked
}

model SecurityEvent {
  id              String              @id @default(uuid(7)) @db.Uuid
  orgId           String              @map("org_id") @db.Uuid
  type            String
  severity        String
  title           String
  agentId         String?             @map("agent_id") @db.Uuid
  actionRequestId String?             @map("action_request_id") @db.Uuid
  policyVersionId String?             @map("policy_version_id") @db.Uuid
  incidentId      String?             @map("incident_id") @db.Uuid
  detail          Json                @default("{}")
  status          SecurityEventStatus @default(open)
  createdAt       DateTime            @default(now()) @map("created_at")

  incident Incident? @relation(fields: [incidentId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, severity, status])
  @@map("security_events")
}

enum IncidentStatus {
  open
  investigating
  contained
  resolved
}

model Incident {
  id         String         @id @default(uuid(7)) @db.Uuid
  orgId      String         @map("org_id") @db.Uuid
  number     Int
  title      String
  severity   String
  status     IncidentStatus @default(open)
  summary    String         @default("")
  assigneeId String?        @map("assignee_id") @db.Uuid
  agentIds   String[]       @default([]) @map("agent_ids") @db.Uuid
  resolvedAt DateTime?      @map("resolved_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  events         IncidentEvent[]
  securityEvents SecurityEvent[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@map("incidents")
}

model IncidentEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  incidentId      String   @map("incident_id") @db.Uuid
  type            String
  actorId         String?  @map("actor_id") @db.Uuid
  note            String   @default("")
  securityEventId String?  @map("security_event_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_events")
}

// ---------- Audit (assessments) ----------

model Framework {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String?  @map("org_id") @db.Uuid
  key         String
  name        String
  version     String   @default("")
  publisher   String   @default("")
  licenseNote String   @default("") @map("license_note")
  description String   @default("")
  isCustom    Boolean  @default(false) @map("is_custom")
  createdAt   DateTime @default(now()) @map("created_at")

  controls    Control[]
  assessments Assessment[]

  @@unique([key, orgId])
  @@map("frameworks")
}

model Control {
  id                    String   @id @default(uuid(7)) @db.Uuid
  frameworkId           String   @map("framework_id") @db.Uuid
  code                  String
  title                 String
  summary               String   @default("")
  category              String   @default("")
  keywords              String[] @default([])
  automatedEvidenceType String?  @map("automated_evidence_type")
  sortOrder             Int      @default(0) @map("sort_order")

  framework Framework        @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  mappings  ControlMapping[]
  findings  Finding[]

  @@unique([frameworkId, code])
  @@map("controls")
}

enum DocumentStatus {
  uploaded
  parsing
  parsed
  failed
}

model Document {
  id             String         @id @default(uuid(7)) @db.Uuid
  orgId          String         @map("org_id") @db.Uuid
  title          String
  filename       String
  mime           String
  size           Int
  sha256         String
  storageKey     String         @map("storage_key")
  status         DocumentStatus @default(uploaded)
  error          String?
  pageCount      Int?           @map("page_count")
  chunkCount     Int            @default(0) @map("chunk_count")
  retentionUntil DateTime?      @map("retention_until")
  uploadedBy     String?        @map("uploaded_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  chunks DocumentChunk[]

  @@index([orgId])
  @@map("documents")
}

model DocumentChunk {
  id         String @id @default(uuid(7)) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  idx        Int
  text       String
  page       Int?
  tokens     Int    @default(0)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, idx])
  @@index([orgId])
  @@map("document_chunks")
}

enum AssessmentStatus {
  draft
  running
  completed
  failed
}

model Assessment {
  id          String           @id @default(uuid(7)) @db.Uuid
  orgId       String           @map("org_id") @db.Uuid
  frameworkId String           @map("framework_id") @db.Uuid
  name        String
  scope       String           @default("")
  status      AssessmentStatus @default(draft)
  documentIds String[]         @default([]) @map("document_ids") @db.Uuid
  summary     Json             @default("{}")
  startedBy   String?          @map("started_by") @db.Uuid
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  framework Framework          @relation(fields: [frameworkId], references: [id])
  findings  Finding[]
  artifacts EvidenceArtifact[]

  @@index([orgId])
  @@map("assessments")
}

enum FindingStatus {
  covered
  partial
  missing
  ambiguous
}

model Finding {
  id             String         @id @default(uuid(7)) @db.Uuid
  orgId          String         @map("org_id") @db.Uuid
  assessmentId   String         @map("assessment_id") @db.Uuid
  controlId      String         @map("control_id") @db.Uuid
  status         FindingStatus
  confidence     Float          @default(0)
  rationale      String         @default("")
  recommendation String         @default("")
  humanStatus    FindingStatus? @map("human_status")
  validatedBy    String?        @map("validated_by") @db.Uuid
  validatedAt    DateTime?      @map("validated_at")
  validationNote String         @default("") @map("validation_note")
  resolvedAt     DateTime?      @map("resolved_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  assessment  Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control     Control            @relation(fields: [controlId], references: [id])
  artifacts   EvidenceArtifact[]
  remediation RemediationTask[]

  @@unique([assessmentId, controlId])
  @@index([orgId])
  @@map("findings")
}

enum ArtifactKind {
  automated
  document
  human
}

model EvidenceArtifact {
  id           String       @id @default(uuid(7)) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  assessmentId String       @map("assessment_id") @db.Uuid
  findingId    String?      @map("finding_id") @db.Uuid
  kind         ArtifactKind
  documentId   String?      @map("document_id") @db.Uuid
  chunkId      String?      @map("chunk_id") @db.Uuid
  excerpt      String       @default("")
  score        Float        @default(0)
  reference    String       @default("")
  addedBy      String?      @map("added_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  finding    Finding?   @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("evidence_artifacts")
}

enum RemediationStatus {
  open
  in_progress
  review
  resolved
  reopened
}

model RemediationTask {
  id                  String            @id @default(uuid(7)) @db.Uuid
  orgId               String            @map("org_id") @db.Uuid
  findingId           String?           @map("finding_id") @db.Uuid
  title               String
  description         String            @default("")
  ownerId             String?           @map("owner_id") @db.Uuid
  dueAt               DateTime?         @map("due_at")
  status              RemediationStatus @default(open)
  evidenceDocumentIds String[]          @default([]) @map("evidence_document_ids") @db.Uuid
  history             Json              @default("[]")
  createdBy           String?           @map("created_by") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  finding Finding? @relation(fields: [findingId], references: [id])

  @@index([orgId, status])
  @@map("remediation_tasks")
}

model AuditExport {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  kind       String
  format     String
  storageKey String   @map("storage_key")
  size       Int      @default(0)
  sha256     String   @default("")
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@map("audit_exports")
}

// ---------- Platform ----------

model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String
  title          String
  body           String    @default("")
  link           String?
  idempotencyKey String    @map("idempotency_key")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([orgId, idempotencyKey])
  @@index([orgId, userId, readAt])
  @@map("notifications")
}

enum JobStatus {
  pending
  running
  done
  failed
}

model Job {
  id             String    @id @default(uuid(7)) @db.Uuid
  orgId          String?   @map("org_id") @db.Uuid
  type           String
  payload        Json      @default("{}")
  /// Stored scoped to the organization ("org:<id>:<key>") so one tenant cannot collide with another's keys.
  idempotencyKey String    @unique @map("idempotency_key")
  runAt          DateTime  @default(now()) @map("run_at")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  status         JobStatus @default(pending)
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("jobs")
}

model PlatformEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  type      String
  actorId   String?  @map("actor_id") @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  detail    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("platform_events")
}

model DeploymentVersion {
  id         String   @id @default(uuid(7)) @db.Uuid
  component  String
  version    String
  gitSha     String   @default("") @map("git_sha")
  deployedAt DateTime @default(now()) @map("deployed_at")
  notes      String   @default("")

  @@map("deployment_versions")
}

enum AccessRequestStatus {
  pending
  approved
  rejected
  expired
  revoked
}

/// A request for time-limited access: a tool or resource permission for one agent, for a stated reason
/// and duration. Someone other than the requester approves it; access ends at expiresAt.
model AccessRequest {
  id            String              @id @default(uuid(7)) @db.Uuid
  orgId         String              @map("org_id") @db.Uuid
  agentId       String              @map("agent_id") @db.Uuid
  toolId        String?             @map("tool_id") @db.Uuid
  resourceId    String?             @map("resource_id") @db.Uuid
  actions       String[]            @default([])
  reason        String
  durationHours Int                 @map("duration_hours")
  status        AccessRequestStatus @default(pending)
  requestedBy   String              @map("requested_by") @db.Uuid
  decidedBy     String?             @map("decided_by") @db.Uuid
  decidedAt     DateTime?           @map("decided_at")
  decisionNote  String?             @map("decision_note")
  expiresAt     DateTime?           @map("expires_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([orgId, status])
  @@index([orgId, agentId])
  @@map("access_requests")
}

enum DiscoveredAgentStatus {
  unregistered
  linked
  ignored
}

/// An AI agent seen somewhere (an integration, deployment metadata, telemetry, an enforcement audit)
/// that may not be in the registry yet.
model DiscoveredAgent {
  id            String                @id @default(uuid(7)) @db.Uuid
  orgId         String                @map("org_id") @db.Uuid
  source        String
  externalId    String                @map("external_id")
  name          String
  platform      String                @default("")
  metadata      Json                  @default("{}")
  observations  Int                   @default(1)
  firstSeenAt   DateTime              @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime              @default(now()) @map("last_seen_at")
  status        DiscoveredAgentStatus @default(unregistered)
  linkedAgentId String?               @map("linked_agent_id") @db.Uuid
  decidedBy     String?               @map("decided_by") @db.Uuid
  note          String?

  @@unique([orgId, source, externalId])
  @@index([orgId, status])
  @@map("discovered_agents")
}

/// Fixed-window request counters shared by every API and web replica (one row per key per window).
model RateLimitBucket {
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

enum AutonomyTransitionKind {
  lowered
  raised
  automatic_downgrade
}

enum AutonomyChangeStatus {
  pending
  approved
  rejected
  expired
  cancelled
}

/// Every change of an agent's autonomy level. Append-only (database trigger).
model AutonomyTransition {
  id              String                 @id @default(uuid(7)) @db.Uuid
  orgId           String                 @map("org_id") @db.Uuid
  agentId         String                 @map("agent_id") @db.Uuid
  fromLevel       Int                    @map("from_level")
  toLevel         Int                    @map("to_level")
  kind            AutonomyTransitionKind
  reason          String
  /// For automatic downgrades: the rule and the facts that triggered it.
  trigger         Json?
  actorType       String                 @map("actor_type")
  actorId         String?                @map("actor_id")
  changeRequestId String?                @map("change_request_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at")

  @@index([orgId, agentId, createdAt])
  @@index([orgId, createdAt])
  @@map("autonomy_transitions")
}

/// A request to raise an agent's autonomy. Raising needs a second person with agents:control.
model AutonomyChangeRequest {
  id            String               @id @default(uuid(7)) @db.Uuid
  orgId         String               @map("org_id") @db.Uuid
  agentId       String               @map("agent_id") @db.Uuid
  fromLevel     Int                  @map("from_level")
  toLevel       Int                  @map("to_level")
  ceilingAmount Decimal?             @map("ceiling_amount") @db.Decimal(18, 2)
  reason        String
  status        AutonomyChangeStatus @default(pending)
  requestedBy   String               @map("requested_by") @db.Uuid
  decidedBy     String?              @map("decided_by") @db.Uuid
  decidedAt     DateTime?            @map("decided_at")
  decisionNote  String?              @map("decision_note")
  expiresAt     DateTime             @map("expires_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([orgId, status])
  @@index([orgId, agentId])
  @@map("autonomy_change_requests")
}

/// Whether an action turned out to be right, recorded by a person, an approver's decision or a customer system.
/// The ground truth for calibrating agents' self-reported confidence.
model OutcomeLabel {
  id              String   @id @default(uuid(7)) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  actionRequestId String   @map("action_request_id") @db.Uuid
  agentId         String   @map("agent_id") @db.Uuid
  toolKey         String   @map("tool_key")
  /// The confidence the agent reported with the request, copied here so calibration needs no join.
  confidence      Float?
  correct         Boolean
  /// approver (from an approval decision), reviewer (a person), system (a customer system with an integration key)
  source          String
  labelledBy      String?  @map("labelled_by")
  note            String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([actionRequestId, source])
  @@index([orgId, agentId, createdAt])
  @@map("outcome_labels")
}

/// Calibration of one agent's confidence (per tool, or across tools when toolKey is "*"), recomputed by the worker.
model CalibrationProfile {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  agentId    String   @map("agent_id") @db.Uuid
  toolKey    String   @map("tool_key")
  sampleSize Int      @map("sample_size")
  ece        Float?
  brier      Float?
  accuracy   Float?
  bins       Json     @default("[]")
  windowDays Int      @map("window_days")
  computedAt DateTime @default(now()) @map("computed_at")

  @@unique([orgId, agentId, toolKey])
  @@map("calibration_profiles")
}

/// One Attack Simulation Lab run: a set of attack scenarios submitted through the gateway by a temporary
/// clone of a target agent, decision-only (nothing executes downstream). docs/ATTACK_SIMULATION_LAB.md
model AttackSimulationRun {
  id            String    @id @default(uuid(7)) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  targetAgentId String    @map("target_agent_id") @db.Uuid
  labAgentId    String?   @map("lab_agent_id") @db.Uuid
  /// running, completed or failed.
  status        String    @default("running")
  scenarioKeys  String[]  @default([]) @map("scenario_keys")
  /// Counts by outcome and the baseline decision.
  summary       Json      @default("{}")
  error         String?
  startedBy     String?   @map("started_by") @db.Uuid
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")

  results AttackSimulationResult[]

  @@index([orgId, startedAt])
  @@map("attack_simulation_runs")
}

/// The result of one scenario in a lab run. Append-only.
model AttackSimulationResult {
  id               String              @id @default(uuid(7)) @db.Uuid
  orgId            String              @map("org_id") @db.Uuid
  runId            String              @map("run_id") @db.Uuid
  scenarioKey      String              @map("scenario_key")
  category         String
  /// defended, gap, inconclusive or error.
  outcome          String
  expected         String
  observed         String
  /// Public taxonomy identifiers (OWASP Top 10 for LLM Applications 2025, MITRE ATLAS).
  references       String[]            @default([])
  actionRequestIds String[]            @default([]) @map("action_request_ids") @db.Uuid
  detail           Json                @default("{}")
  createdAt        DateTime            @default(now()) @map("created_at")
  run              AttackSimulationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([orgId, runId])
  @@map("attack_simulation_results")
}

/// Lifecycle of a registered AI model. Only "approved" models pass the model-governance gateway check
/// when it is switched on; "deprecated" is allowed with a risk indicator.
enum ModelStage {
  proposed
  evaluating
  approved
  deprecated
  retired
}

/// An AI model the organization uses or plans to use (docs/MODEL_DATA_GOVERNANCE.md).
model AiModel {
  id                  String     @id @default(uuid(7)) @db.Uuid
  orgId               String     @map("org_id") @db.Uuid
  key                 String
  name                String
  provider            String
  /// The provider's model identifier, as agents report it (agents.model_id).
  providerModelId     String     @map("provider_model_id")
  version             String     @default("")
  stage               ModelStage @default(proposed)
  riskTier            String     @default("medium") @map("risk_tier")
  intendedUse         String     @default("") @map("intended_use")
  limitations         String     @default("")
  /// Data categories the model may receive (personal, financial, health and so on).
  dataCategories      String[]   @default([]) @map("data_categories")
  /// Where the organization states the model is hosted. Declared, not verified by AEGIS.
  hostingRegion       String     @default("") @map("hosting_region")
  ownerId             String?    @map("owner_id") @db.Uuid
  /// Who asked for approval; a different person must approve.
  approvalRequestedBy String?    @map("approval_requested_by") @db.Uuid
  approvedBy          String?    @map("approved_by") @db.Uuid
  approvedAt          DateTime?  @map("approved_at")
  /// Approval lapses into "review overdue" after this time. Null: no periodic review.
  reviewDueAt         DateTime?  @map("review_due_at")
  createdBy           String?    @map("created_by") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  evaluations  ModelEvaluation[]
  stageChanges ModelStageChange[]

  @@unique([orgId, key])
  @@index([orgId, stage])
  @@map("ai_models")
}

/// An evaluation of a model recorded by a person. Append-only.
model ModelEvaluation {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  modelId    String   @map("model_id") @db.Uuid
  /// accuracy, safety, bias, security, privacy or other.
  kind       String
  /// pass, conditional or fail.
  result     String
  summary    String
  metrics    Json     @default("{}")
  documentId String?  @map("document_id") @db.Uuid
  recordedBy String?  @map("recorded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  model      AiModel  @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([orgId, modelId])
  @@map("model_evaluations")
}

/// Every stage change of a model. Append-only.
model ModelStageChange {
  id        String     @id @default(uuid(7)) @db.Uuid
  orgId     String     @map("org_id") @db.Uuid
  modelId   String     @map("model_id") @db.Uuid
  fromStage ModelStage @map("from_stage")
  toStage   ModelStage @map("to_stage")
  reason    String
  actorId   String?    @map("actor_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  model     AiModel    @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([orgId, modelId, createdAt])
  @@map("model_stage_changes")
}

/// A dataset agents can reach, with its governance facts (docs/MODEL_DATA_GOVERNANCE.md).
model Dataset {
  id              String             @id @default(uuid(7)) @db.Uuid
  orgId           String             @map("org_id") @db.Uuid
  key             String
  name            String
  description     String             @default("")
  ownerId         String?            @map("owner_id") @db.Uuid
  classification  DataClassification @default(internal)
  /// personal, financial, health, biometric, children, credentials, location and so on.
  categories      String[]           @default([])
  /// The gateway resource that fronts this dataset; access auditing uses its permissions and requests.
  resourceId      String?            @map("resource_id") @db.Uuid
  /// Where the organization states the data is stored. Declared, not verified by AEGIS.
  storageLocation String             @default("") @map("storage_location")
  region          String             @default("")
  /// Null: no retention period recorded, which the inventory flags.
  retentionDays   Int?               @map("retention_days")
  lawfulBasis     String             @default("") @map("lawful_basis")
  createdBy       String?            @map("created_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  deletionRequests DataDeletionRequest[]

  @@unique([orgId, key])
  @@map("datasets")
}

enum DeletionRequestStatus {
  requested
  approved
  rejected
  completed
}

/// A request to delete one data subject's records from a dataset. AEGIS records the decision and the
/// completion attestation; the deletion itself happens in the customer's system. The subject reference
/// is stored only as a keyed hash.
model DataDeletionRequest {
  id                  String                @id @default(uuid(7)) @db.Uuid
  orgId               String                @map("org_id") @db.Uuid
  datasetId           String                @map("dataset_id") @db.Uuid
  /// HMAC-SHA-256 of the subject reference; the reference itself is never stored.
  subjectRefHash      String                @map("subject_ref_hash")
  /// The last 4 characters of the reference, so people can tell requests apart.
  subjectHint         String                @default("") @map("subject_hint")
  reason              String
  status              DeletionRequestStatus @default(requested)
  dueAt               DateTime              @map("due_at")
  requestedBy         String?               @map("requested_by") @db.Uuid
  decidedBy           String?               @map("decided_by") @db.Uuid
  decidedAt           DateTime?             @map("decided_at")
  decisionNote        String?               @map("decision_note")
  completedBy         String?               @map("completed_by") @db.Uuid
  completedAt         DateTime?             @map("completed_at")
  /// The customer system's reference for the deletion (a ticket or job id).
  completionReference String?               @map("completion_reference")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  dataset             Dataset               @relation(fields: [datasetId], references: [id], onDelete: Restrict)

  @@index([orgId, status])
  @@map("data_deletion_requests")
}

enum RegulatoryChangeStatus {
  new
  assessing
  action_required
  implemented
  not_applicable
}

/// A regulatory or standards change entered by a person, with its impact assessment and actions.
/// AEGIS does not monitor regulators; entries are recorded by the organization.
model RegulatoryChange {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  orgId              String                 @map("org_id") @db.Uuid
  title              String
  source             String
  reference          String                 @default("")
  jurisdiction       String                 @default("")
  frameworkId        String?                @map("framework_id") @db.Uuid
  publishedAt        DateTime?              @map("published_at")
  effectiveAt        DateTime?              @map("effective_at")
  summary            String                 @default("")
  status             RegulatoryChangeStatus @default(new)
  /// { controls, policies, agents, models, datasets: string[] (ids), notes: string }
  impact             Json                   @default("{}")
  assessedBy         String?                @map("assessed_by") @db.Uuid
  assessedAt         DateTime?              @map("assessed_at")
  decisionNote       String?                @map("decision_note")
  remediationTaskIds String[]               @default([]) @map("remediation_task_ids") @db.Uuid
  ownerId            String?                @map("owner_id") @db.Uuid
  createdBy          String?                @map("created_by") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@index([orgId, status])
  @@index([orgId, effectiveAt])
  @@map("regulatory_changes")
}

/// Where AEGIS sends governance events (docs/INTEGRATIONS.md). The secret (a webhook URL with a token,
/// an API key or a password) is encrypted with the master key; non-secret settings live in config.
model EventDestination {
  id                  String    @id @default(uuid(7)) @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  /// webhook, slack, teams, splunk_hec, datadog_logs or servicenow.
  kind                String
  name                String
  /// Event categories this destination receives (security, approvals, decisions, agents, monitoring, governance, lab, audit).
  categories          String[]  @default([])
  /// Only for security events: the lowest severity sent. Null sends every severity.
  minSeverity         String?   @map("min_severity")
  enabled             Boolean   @default(true)
  config              Json      @default("{}")
  secretEnvelope      String    @map("secret_envelope")
  /// The highest evidence sequence number already considered for this destination.
  cursorSeq           BigInt    @default(0) @map("cursor_seq")
  /// Set while a dispatcher holds this destination, so two workers never deliver for it at once.
  dispatchLockedUntil DateTime? @map("dispatch_locked_until")
  lastDeliveredAt     DateTime? @map("last_delivered_at")
  lastError           String?   @map("last_error")
  /// The last successful test delivery: proof the real endpoint accepted an AEGIS event.
  verifiedAt          DateTime? @map("verified_at")
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  deliveries EventDelivery[]

  @@index([orgId, enabled])
  @@map("event_destinations")
}

/// One evidence event to one destination. Unique per pair, so a delivery is attempted once and retried, never duplicated.
model EventDelivery {
  id              String           @id @default(uuid(7)) @db.Uuid
  orgId           String           @map("org_id") @db.Uuid
  destinationId   String           @map("destination_id") @db.Uuid
  /// The evidence event delivered, or null for a test delivery.
  evidenceEventId String?          @map("evidence_event_id") @db.Uuid
  eventType       String           @map("event_type")
  /// pending, delivered or failed.
  status          String           @default("pending")
  attempts        Int              @default(0)
  nextAttemptAt   DateTime         @default(now()) @map("next_attempt_at")
  responseStatus  Int?             @map("response_status")
  lastError       String?          @map("last_error")
  deliveredAt     DateTime?        @map("delivered_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  destination     EventDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, evidenceEventId])
  @@index([orgId, status, nextAttemptAt])
  @@index([destinationId, createdAt])
  @@map("event_deliveries")
}

enum PolicyExceptionStatus {
  requested
  approved
  rejected
  revoked
}

/// A time-limited exception that skips one policy rule for one agent (optionally one tool). Requested
/// by one person, approved by another with policies:activate, always expiring. Recorded on every
/// decision it affects. Later stages (data protection, uncertainty, autonomy) still apply.
model PolicyException {
  id            String                @id @default(uuid(7)) @db.Uuid
  orgId         String                @map("org_id") @db.Uuid
  policyId      String                @map("policy_id") @db.Uuid
  policyKey     String                @map("policy_key")
  ruleId        String                @map("rule_id")
  agentId       String                @map("agent_id") @db.Uuid
  /// Null: every tool the rule covers.
  toolKey       String?               @map("tool_key")
  reason        String
  status        PolicyExceptionStatus @default(requested)
  startsAt      DateTime              @default(now()) @map("starts_at")
  expiresAt     DateTime              @map("expires_at")
  requestedBy   String?               @map("requested_by") @db.Uuid
  decidedBy     String?               @map("decided_by") @db.Uuid
  decidedAt     DateTime?             @map("decided_at")
  decisionNote  String?               @map("decision_note")
  revokedReason String?               @map("revoked_reason")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([orgId, agentId, status])
  @@index([orgId, policyId])
  @@map("policy_exceptions")
}

// ---------- Commercial (Phase 12) ----------

enum BillingPeriod {
  monthly
  quarterly
  annual
}

/// The commercial terms agreed with a customer. Amounts are entered by the provider from the signed
/// contract; AEGIS has no price list. One active contract per organization; replaced ones stay for history.
model CommercialContract {
  id                    String        @id @default(uuid(7)) @db.Uuid
  orgId                 String        @map("org_id") @db.Uuid
  plan                  String
  active                Boolean       @default(true)
  termStart             DateTime      @map("term_start")
  termEnd               DateTime      @map("term_end")
  billingPeriod         BillingPeriod @default(monthly) @map("billing_period")
  currency              String        @default("AED")
  /// Fee per billing period, in minor units (fils for AED).
  periodFeeMinor        BigInt        @map("period_fee_minor")
  /// Gateway decisions included per billing period; null means unlimited.
  includedDecisions     Int?          @map("included_decisions")
  /// Price per decision above the included amount, in ten-thousandths of the major unit.
  overageUnitPrice4     BigInt?       @map("overage_unit_price_4")
  /// Tax rate in basis points (500 = 5%). Zero unless the provider is registered and the contract says so.
  taxRateBp             Int           @default(0) @map("tax_rate_bp")
  paymentTermsDays      Int           @default(30) @map("payment_terms_days")
  purchaseOrder         String?       @map("purchase_order")
  /// Overrides for plan limits: { agents?, members?, monthlyDecisions? }.
  limits                Json          @default("{}")
  notes                 String        @default("")
  createdBy             String        @map("created_by") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  invoices Invoice[]

  @@index([orgId, active])
  @@map("commercial_contracts")
}

/// Usage measured from the organization's own records for one calendar month. Written idempotently.
model UsageRecord {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  /// Calendar month, YYYY-MM (UTC).
  period     String
  metric     String
  value      BigInt
  computedAt DateTime @default(now()) @map("computed_at")

  @@unique([orgId, period, metric])
  @@map("usage_records")
}

enum InvoiceStatus {
  draft
  issued
  paid
  void
}

/// An invoice document. AEGIS does not collect payment: a provider records payment it received elsewhere.
model Invoice {
  id               String        @id @default(uuid(7)) @db.Uuid
  orgId            String        @map("org_id") @db.Uuid
  contractId       String        @map("contract_id") @db.Uuid
  number           String
  status           InvoiceStatus @default(draft)
  periodStart      DateTime      @map("period_start")
  periodEnd        DateTime      @map("period_end")
  currency         String
  lines            Json
  subtotalMinor    BigInt        @map("subtotal_minor")
  taxMinor         BigInt        @map("tax_minor")
  totalMinor       BigInt        @map("total_minor")
  issuedAt         DateTime?     @map("issued_at")
  dueAt            DateTime?     @map("due_at")
  paidAt           DateTime?     @map("paid_at")
  paymentReference String?       @map("payment_reference")
  voidReason       String?       @map("void_reason")
  createdBy        String        @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  contract CommercialContract @relation(fields: [contractId], references: [id])

  @@unique([orgId, number])
  @@index([orgId, status])
  @@map("invoices")
}

enum SupportSeverity {
  low
  normal
  high
  urgent
}

enum SupportStatus {
  open
  in_progress
  resolved
}

/// A customer's request to the provider's support team.
model SupportRequest {
  id         String          @id @default(uuid(7)) @db.Uuid
  orgId      String          @map("org_id") @db.Uuid
  createdBy  String          @map("created_by") @db.Uuid
  subject    String
  body       String
  severity   SupportSeverity @default(normal)
  status     SupportStatus   @default(open)
  resolution String          @default("")
  resolvedAt DateTime?       @map("resolved_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([orgId, status])
  @@map("support_requests")
}
