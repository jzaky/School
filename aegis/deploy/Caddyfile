# Reverse proxy with automatic HTTPS for a single-VM deployment. Replace the two hostnames.
# Install Caddy (https://caddyserver.com/docs/install), copy this file to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
# Point DNS A records for both hostnames at the VM first; Caddy obtains certificates on first request.
console.example.com {
	reverse_proxy 127.0.0.1:3000
	encode gzip
}

api.example.com {
	reverse_proxy 127.0.0.1:4000
	encode gzip
}
