# Database. The app role must not own the tables (see docs/DATABASE.md).
# Add ?connection_limit=N with N at least the gateway concurrency you expect (25 in docs/PERFORMANCE.md) and below
# PostgreSQL max_connections divided by the number of API and worker processes.
DATABASE_URL=postgresql://aegis_app:aegis_app_dev@127.0.0.1:5432/aegis
# Owner role. Only the migrate job, seeds and platform scripts may carry it. In production the api, web and
# worker refuse to start when it is present in their environment (see docs/DEPLOYMENT.md).
MIGRATION_DATABASE_URL=postgresql://aegis_owner:aegis_owner_dev@127.0.0.1:5432/aegis
# Optional: which process this environment belongs to (api, web, worker, migrate, script). Set per container.
# AEGIS_PROCESS=api
# Where uploaded documents and exports are stored. Relative paths resolve against the monorepo root. Every process
# (api, web, worker) must see the same directory or volume.
AEGIS_STORAGE_DIR=.uploads
REDIS_URL=redis://127.0.0.1:6379

# 32 bytes base64. Encrypts credentials, SSO secrets and MFA secrets at rest.
AEGIS_MASTER_KEY=
# Ed25519 private key (PKCS8 PEM, base64 encoded) used to sign evidence checkpoints. Generate with: pnpm --filter @aegis/core keygen
EVIDENCE_SIGNING_KEY=
# Retired evidence public keys (SPKI PEM, base64, comma separated) so checkpoints signed before a key rotation still verify.
EVIDENCE_VERIFY_KEYS=
# Platform administrator password for the demo seed (12+ characters). Unset: a random one is written to .demo-keys.json.
AEGIS_PLATFORM_ADMIN_PASSWORD=
# Random 32 bytes base64 used to derive HMACs for session cookies and grants.
AEGIS_SESSION_SECRET=

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Comma separated list of origins allowed to call the API from a browser.
API_CORS_ORIGINS=http://localhost:3000

# Demo tenant (synthetic data, clearly labelled in the UI). Set to false in production.
AEGIS_DEMO_MODE=true

# Optional: OpenTelemetry OTLP endpoint. Export is disabled when empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aegis

# Optional: email copies of approval requests, quarantines, alerts and incidents (packages/core/src/notify/email.ts).
# Off unless AEGIS_EMAIL_NOTIFICATIONS=true. With it on and no RESEND_API_KEY, the console provider logs instead.
AEGIS_EMAIL_NOTIFICATIONS=false
RESEND_API_KEY=
EMAIL_FROM=aegis@example.com

LOG_LEVEL=info
NODE_ENV=development

# Optional: where this installation runs, for the Deployment page and residency assessment.
# Inline JSON or a path, for example deploy/profiles/uae-single-tenant.example.json. See docs/DEPLOYMENT_OPTIONS.md.
AEGIS_DEPLOYMENT_MANIFEST=

# Record every database query duration as a metric (aegis_db_query_seconds). Off by default: it costs CPU on every query.
# AEGIS_DB_QUERY_METRICS=1
