{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "src/**",
      "prisma/**",
      "public/**",
      "assets/**",
      "messages/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "Dockerfile",
      "next.config.*",
      "tsconfig.json",
      "postcss.config.*",
      "railway.json",
      "railway.worker.json"
    ]
  },
  "deploy": {
    "startCommand": "/app/scripts/docker-start.sh",
    "healthcheckPath": "/login",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
