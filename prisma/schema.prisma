  REJECTED
  CANCELLED
  WAITING
}

enum HostMode {
  SPECIFIC
  ROUND_ROBIN
}

enum LocationType {
  IN_PERSON
  ONLINE
  PHONE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CalendarEventKind {
  EVENT
  DEADLINE
  HOLIDAY
  EXAM
  FOLLOW_UP
}

enum DocumentSource {
  UPLOAD
  GENERATED
}

enum DocumentOutput {
  EN
  AR
  BILINGUAL
}

enum RecommendationStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum ShortlistCategory {
  REACH
  TARGET
  SAFETY
}

enum ApplicationStatus {
  RESEARCHING
  PREPARING
  SUBMITTED
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MessageChannel {
  INTERNAL
  EMAIL
  SMS
  WHATSAPP
}

/// Who can read a message in a request conversation (src/server/requests/conversation.ts).
enum MessageVisibility {
  /// Family and staff: the family (requester, guardians, the student where allowed) and the handling team.
  SHARED
  /// Staff only: an internal note for everyone on staff who can see the request. Never shown to families.
  STAFF
  /// Private: only the author and the staff members they chose.
  PRIVATE
}

/// Where an attendance mark came from. Absences reported by the family keep their reason on the request.
enum AttendanceSource {
  REGISTER
  PARENT
  STUDENT
  OFFICE
}

/// The private reason for a staff absence. Seen only by the absent person, the person who reported it
/// and staff with absence.reasons; substitutes and colleagues never see it.
enum StaffAbsenceReason {
  SICK
  MEDICAL_APPOINTMENT
  ANNUAL_LEAVE
  FAMILY
  PARENTAL_LEAVE
  RELIGIOUS
  TRAINING
  SCHOOL_BUSINESS
  PERSONAL
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
