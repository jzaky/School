// ---------------------------------------------------------------------------
// Communications and notifications
// ---------------------------------------------------------------------------

model Message {
  id           String         @id @default(cuid())
  orgId        String
  caseId       String?
  requestId    String?
  channel      MessageChannel @default(INTERNAL)
  fromId       String
  toLabel      String?
  toGuardianId String?
  subject      String?
  body         String
  status       DeliveryStatus @default(SENT)
  createdAt    DateTime       @default(now())

  @@index([orgId, caseId])
  @@index([orgId, requestId])
}

/// One message in a request conversation. Families only ever receive SHARED messages; STAFF notes are for
/// staff who can see the request; PRIVATE notes for the author and `privateToIds`. Never searched or counted
/// in analytics. Reads and writes go through src/server/requests/conversation.ts.
model RequestMessage {
  id             String            @id @default(cuid())
  orgId          String
  requestId      String
  /// The author.
  membershipId   String
  visibility     MessageVisibility @default(SHARED)
  /// PRIVATE only: the staff members, besides the author, who may read it.
  privateToIds   String[]
  body           String
  /// Set when staff chose to notify the family on a wellbeing or safeguarding matter (a recorded decision).
  familyNotified Boolean           @default(false)
  createdAt      DateTime          @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([orgId, requestId, createdAt])
}

/// When a member last opened a request conversation (unread indicators).
model RequestThreadRead {
  id           String   @id @default(cuid())
  orgId        String
  requestId    String
  membershipId String
  lastReadAt   DateTime

  @@unique([requestId, membershipId])
  @@index([orgId, membershipId])
}

model Notification {
  id          String      @id @default(cuid())
  orgId       String
  recipientId String
  kind        String
  titleEn     String
  titleAr     String
  bodyEn      String?
  bodyAr      String?
  href        String?
  sensitivity Sensitivity @default(STANDARD)
  urgent      Boolean     @default(false)
  readAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([orgId, recipientId, readAt])
}

model NotificationPreference {
  id           String                @id @default(cuid())
  orgId        String
  membershipId String
  kind         String
  channels     NotificationChannel[]

  @@unique([membershipId, kind])
  @@index([orgId])
}

/// A browser or phone that receives web push notifications for one membership.
model PushSubscription {
  id            String    @id @default(cuid())
  orgId         String
  membershipId  String
  endpoint      String
  p256dh        String
  auth          String
  deviceLabel   String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@unique([orgId, endpoint])
  @@index([orgId, membershipId])
}

/// A member's consent to receive school notifications on WhatsApp at one phone number.
model WhatsAppOptIn {
  id             String    @id @default(cuid())
  orgId          String
  membershipId   String    @unique
  /// E.164 number, for example +971501234567.
  phone          String
  consentedAt    DateTime
  consentVersion String
  withdrawnAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([orgId])
}

model MessageTemplate {
  id        String              @id @default(cuid())
  orgId     String
  key       String
  channel   NotificationChannel
  subjectEn String?
  subjectAr String?
  bodyEn    String
  bodyAr    String
  updatedAt DateTime            @updatedAt

  @@unique([orgId, key, channel])
}

model OutboundMessage {
  id             String              @id @default(cuid())
  orgId          String
  channel        NotificationChannel
  to             String
  templateKey    String?
  subject        String?
  idempotencyKey String
  status         DeliveryStatus      @default(QUEUED)
  providerId     String?
  error          String?
  createdAt      DateTime            @default(now())
  sentAt         DateTime?

  @@unique([orgId, idempotencyKey])
}

model Announcement {
  id          String   @id @default(cuid())
  orgId       String
  titleEn     String
  titleAr     String
  bodyEn      String
  bodyAr      String
  audience    String[]
  publishedAt DateTime @default(now())
  authorId    String?

  @@index([orgId, publishedAt])
}

