// School Operations OS - data model
// Every tenant table carries orgId and is protected by Row-Level Security (prisma/rls.sql).
// Global tables (no orgId): User, Account, VerificationToken. Organization is protected by id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Locale {
  en
  ar
}

enum Sensitivity {
  STANDARD
  CONFIDENTIAL
  MEDICAL
  WELLBEING
  SAFEGUARDING
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  PENDING_APPROVAL
  SUSPENDED
}

enum PersonStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum CaseType {
