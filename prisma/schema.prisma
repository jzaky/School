  orgId        String
  tripId       String
  studentId    String
  consent      TripConsent @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  noteEn       String?
  documentId   String?
  letterSentAt DateTime?
  createdAt    DateTime    @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, studentId])
  @@index([orgId, studentId])
