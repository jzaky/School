  DONE
  CANCELLED
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

enum StepRunStatus {
