  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Demo, jobs, imports
// ---------------------------------------------------------------------------

/// A school-wide data export (school exit). Built by the worker, downloaded through an expiring link.
model DataExport {
  id             String    @id @default(cuid())
