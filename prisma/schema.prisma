// ---------------------------------------------------------------------------
// University pathways
// ---------------------------------------------------------------------------

enum SchoolCurriculum {
  BRITISH
  IB
  AMERICAN
  UAE_MOE
  JORDAN_TAWJIHI
  CBSE
  ISC
  SABIS
  OTHER
}

/// A degree programme with entry requirements per school curriculum. Requirements are indicative
/// and carry their source and the date they were last checked.
model UniversityProgram {
  id                  String    @id @default(cuid())
  /// Null for the shared global catalog; set for a school's own additions.
  orgId               String?
  universityId        String
  key                 String
  nameEn              String
  nameAr              String
  field               String
  degree              String
  durationYears       Float     @default(3)
  requiredSubjects    String[]
  recommendedSubjects String[]
  requirements        Json
  englishReq          Json?
  notesEn             String?
  notesAr             String?
  sourceUrl           String?
  lastVerifiedAt      DateTime?
  indicative          Boolean   @default(true)
  campusId            String?
  degreeType          String?
  level               String    @default("UNDERGRADUATE")
  fieldKeys           String[]
  tuitionPerYear      Int?
  tuitionCurrency     String?
  teachingLanguage    String?
  searchText          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([orgId, key])
  @@index([orgId, universityId])
  @@index([fieldKeys])
}

/// A student's predicted or achieved result in a subject, used by the requirements checker.
model StudentSubjectResult {
  id          String           @id @default(cuid())
  orgId       String
  studentId   String
  subjectCode String
  curriculum  SchoolCurriculum @default(BRITISH)
  level       String?
  predicted   String?
  achieved    String?
  updatedById String?
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, subjectCode, level])
  @@index([orgId, studentId])
}

model StudentTestScore {
  id        String    @id @default(cuid())
  orgId     String
  studentId String
  kind      String
  score     Float
  takenAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([orgId, studentId])
}

// ---------------------------------------------------------------------------
// Curriculum, lesson planning and coverage
// ---------------------------------------------------------------------------

enum LessonPlanStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

model CurriculumFramework {
  id          String   @id @default(cuid())
  orgId       String
  key         String
  nameEn      String
  nameAr      String
  sourceEn    String?
  subjectId   String?
  gradeLevel  Int?
  createdById String?
  createdAt   DateTime @default(now())

  standards CurriculumStandard[]

  @@unique([orgId, key])
}

model CurriculumStandard {
  id          String @id @default(cuid())
  orgId       String
  frameworkId String
  code        String
  strandEn    String
  strandAr    String
  descEn      String
  descAr      String
  sortOrder   Int    @default(0)

  framework CurriculumFramework  @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  lessons   LessonPlanStandard[]

  @@unique([frameworkId, code])
  @@index([orgId])
}

model LessonPlan {
  id              String           @id @default(cuid())
  orgId           String
  subjectId       String
  gradeLevel      Int
  classId         String?
  termId          String?
  weekNo          Int?
  plannedFor      DateTime?
  titleEn         String
  titleAr         String
  objectivesEn    String?
  objectivesAr    String?
  activities      Json?
  materials       Json?
  assessmentEn    String?
  assessmentAr    String?
  differentiation String?
  durationMin     Int              @default(50)
  status          LessonPlanStatus @default(DRAFT)
  authorId        String
  reviewerId      String?
  reviewComment   String?
  reviewedAt      DateTime?
  aiDrafted       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  standards LessonPlanStandard[]

  @@index([orgId, subjectId, gradeLevel])
}

model LessonPlanStandard {
  id           String @id @default(cuid())
  orgId        String
  lessonPlanId String
  standardId   String

  lessonPlan LessonPlan         @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  standard   CurriculumStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@unique([lessonPlanId, standardId])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Teacher assignment, timetable and exams
// ---------------------------------------------------------------------------

/// Which subjects and grades a teacher can teach, and how many periods a week they can take.
model TeacherSubject {
  id                String   @id @default(cuid())
  orgId             String
  membershipId      String
  subjectId         String
  gradeLevels       Int[]
  maxPeriodsPerWeek Int      @default(24)
  createdAt         DateTime @default(now())

  @@unique([membershipId, subjectId])
  @@index([orgId])
}

enum PeriodKind {
  LESSON
  BREAK
  ASSEMBLY
}

/// The bell schedule: which periods exist on which school day.
model BellPeriod {
  id             String     @id @default(cuid())
  orgId          String
  academicYearId String
  dayOfWeek      Int
  periodNo       Int
  startTime      String
  endTime        String
  kind           PeriodKind @default(LESSON)

  @@unique([academicYearId, dayOfWeek, periodNo])
  @@index([orgId])
}

/// One lesson in the weekly timetable. A teacher and a class can only be in one place per period.
model TimetableSlot {
  id                  String   @id @default(cuid())
  orgId               String
  academicYearId      String
  classId             String
  teacherMembershipId String?
  dayOfWeek           Int
  periodNo            Int
  room                String?
  locked              Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@unique([classId, dayOfWeek, periodNo])
  @@index([orgId, academicYearId])
  @@index([teacherMembershipId, dayOfWeek, periodNo])
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

model ExamSitting {
  id              String     @id @default(cuid())
  orgId           String
  termId          String?
  subjectId       String
  gradeLevel      Int
  titleEn         String
  titleAr         String
  startsAt        DateTime
  endsAt          DateTime
  room            String?
  invigilatorIds  String[]
  status          ExamStatus @default(DRAFT)
  calendarEventId String?
  createdAt       DateTime   @default(now())

  @@index([orgId, startsAt])
}

// ---------------------------------------------------------------------------
// Staff absence and cover
// ---------------------------------------------------------------------------

enum AbsenceStatus {
  REPORTED
  COVERED
  PARTLY_COVERED
  CANCELLED
}

enum CoverStatus {
  ASSIGNED
  UNCOVERED
  DECLINED
  DONE
}

/// A teacher marked absent for a date range; cover is arranged for each affected lesson.
model StaffAbsence {
  id            String              @id @default(cuid())
  orgId         String
  membershipId  String
  startsOn      DateTime            @db.Date
  endsOn        DateTime            @db.Date
  allDay        Boolean             @default(true)
  fromPeriod    Int?
  toPeriod      Int?
  /// Private: why the person is away. Only the absent person, the reporter and absence.reasons holders see it.
  reasonKind    StaffAbsenceReason?
  /// Private: optional details for the reason. Never shown to substitutes or colleagues.
  privateReason String?
  /// Shared with substitutes: lesson instructions. Must not hold private or medical details.
  coverNotes    String?
  /// The leave request this absence came from, when it was approved through the staff_leave service.
  requestId     String?
  status        AbsenceStatus       @default(REPORTED)
  reportedById  String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  covers CoverAssignment[]

  @@index([orgId, startsOn])
}

/// One lesson that needs cover: which substitute takes it, and whether they were told.
model CoverAssignment {
  id                String      @id @default(cuid())
  orgId             String
  absenceId         String
  slotId            String
  date              DateTime    @db.Date
  periodNo          Int
  classId           String
  originalTeacherId String
  substituteId      String?
  status            CoverStatus @default(ASSIGNED)
  reasonEn          String?
  notifiedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  absence StaffAbsence @relation(fields: [absenceId], references: [id], onDelete: Cascade)

  @@unique([absenceId, slotId, date])
  @@index([orgId, date])
  @@index([substituteId, date])
}

// ---------------------------------------------------------------------------
// Global university requirements and academic pathway engine
// ---------------------------------------------------------------------------
// Catalog tables with a nullable orgId are shared: rows with orgId null belong to the global
// catalog (maintained by the platform ingestion pipeline and read by every school); rows with an
// orgId are a school's own additions. See prisma/rls.sql for the matching policies.

enum SubjectLevel {
  FOUNDATION
  STANDARD
  ADVANCED
  HIGHER
}

enum SubjectRequirementType {
  REQUIRED
  RECOMMENDED
  PREFERRED
  OPTIONAL
  ONE_OF
  TWO_OF
}

enum DataConfidence {
  VERIFIED
  /// Taken from the university's official page, with a verbatim quote for every value, not yet checked by a person.
  OFFICIAL
  REVIEWED
  EXTRACTED
  EXAMPLE
  UNKNOWN
}

enum MatchStatus {
  ELIGIBLE
  ON_TRACK
  POSSIBLY_ELIGIBLE
  MISSING_REQUIREMENTS
  NEEDS_MANUAL_REVIEW
  UNKNOWN_DATA
}

enum StudentCourseStatus {
  COMPLETED
  IN_PROGRESS
  PLANNED
}

enum MappingStatus {
  AUTO
  NEEDS_REVIEW
  CONFIRMED
}

enum CoursePlanStatus {
  DRAFT
  PROPOSED
  APPROVED
  ARCHIVED
}

enum SourceStatus {
  PENDING
  FETCHED
  UNCHANGED
  CHANGED
  FAILED
}

enum ExtractionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ChangeStatus {
  NEEDS_REVIEW
  ACKNOWLEDGED
}

enum ApplicationStage {
  RESEARCHING
  SHORTLISTED
  PREPARING
  SUBMITTED
  INTERVIEW
  OFFER
  REJECTED
  WAITLISTED
  ACCEPTED
  ENROLLED
}

enum ApplicationItemStatus {
  TODO
  IN_PROGRESS
  DONE
  WAIVED
}

/// A curriculum-neutral academic concept (for example Mathematics, Calculus, Physics). Global.
model CanonicalSubject {
  key       String  @id
  nameEn    String
  nameAr    String
  category  String
  parentKey String?
  sortOrder Int     @default(0)
}

/// A field of study that degrees and careers map to (for example computer_science). Global.
model FieldOfStudy {
  key       String   @id
  nameEn    String
  nameAr    String
  cipCodes  String[]
  related   String[]
  sortOrder Int      @default(0)
}

/// Which fields of study lead to a career (career keys match Career.key). Global.
model CareerField {
  id        String @id @default(cuid())
  careerKey String
  fieldKey  String
  weight    Int    @default(3)

  @@unique([careerKey, fieldKey])
}

model UniversityCampus {
  id           String  @id @default(cuid())
  orgId        String?
  universityId String
  nameEn       String
  nameAr       String
  cityEn       String
  cityAr       String
  countryCode  String

  @@index([universityId])
}

model ProgramIntake {
  id               String    @id @default(cuid())
  orgId            String?
  programId        String
  intakeYear       Int
  cycleLabel       String?
  applicationOpens DateTime?
  isCurrent        Boolean   @default(true)

  @@unique([programId, intakeYear])
}

/// A course as it exists in a curriculum (for example "A-Level Mathematics", "AP Calculus BC",
/// "CBSE Mathematics Class 12"). Global rows describe standard qualifications; school rows add local courses.
model CurriculumCourse {
  id            String           @id @default(cuid())
  orgId         String?
  curriculum    SchoolCurriculum
  code          String
  nameEn        String
  nameAr        String
  qualification String
  gradeLevel    Int?
  gradeScale    String
  createdAt     DateTime         @default(now())

  mappings CurriculumCourseMapping[]

  @@unique([orgId, curriculum, code])
  @@index([curriculum])
}

/// How a curriculum course counts toward a canonical subject, at what level and rigour.
model CurriculumCourseMapping {
  id                  String       @id @default(cuid())
  orgId               String?
  courseId            String
  canonicalSubjectKey String
  level               SubjectLevel
  rigorScore          Int          @default(3)
  confidence          Float        @default(1)
  reviewedById        String?
  reviewedAt          DateTime?

  course CurriculumCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([orgId, courseId, canonicalSubjectKey])
  @@index([canonicalSubjectKey])
}

/// A course the school actually offers, by grade. The planner only recommends these.
model SchoolCourse {
  id          String   @id @default(cuid())
  orgId       String
  courseId    String
  subjectId   String?
  gradeLevels Int[]
  active      Boolean  @default(true)
  notesEn     String?
  notesAr     String?
  createdAt   DateTime @default(now())

  @@unique([orgId, courseId])
}

/// A course on a student's record: completed, in progress or planned, with actual or predicted grades.
model StudentCourse {
  id             String              @id @default(cuid())
  orgId          String
  studentId      String
  courseId       String?
  localName      String
  gradeLevel     Int
  schoolYear     String?
  status         StudentCourseStatus
  finalGrade     String?
  predictedGrade String?
  gradeScale     String?
  source         String              @default("MANUAL")
  mappingStatus  MappingStatus       @default(AUTO)
  importId       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([orgId, studentId])
}

model TranscriptImport {
  id          String       @id @default(cuid())
  orgId       String
  studentId   String?
  fileName    String
  kind        String
  status      ImportStatus @default(PENDING)
  rows        Json?
  errors      Json?
  createdById String
  createdAt   DateTime     @default(now())

  @@index([orgId])
}

/// A student's grade 9 to 12 course plan, which a counselor can approve.
model StudentCoursePlan {
  id               String           @id @default(cuid())
  orgId            String
  studentId        String
  name             String
  status           CoursePlanStatus @default(DRAFT)
  goalCareerKey    String?
  goalFieldKeys    String[]
  targetCountries  String[]
  targetProgramIds String[]
  proposedById     String?
  approvedById     String?
  approvedAt       DateTime?
  counselorNote    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items StudentCoursePlanItem[]

  @@index([orgId, studentId])
}

model StudentCoursePlanItem {
  id             String  @id @default(cuid())
  orgId          String
  planId         String
  gradeLevel     Int
  schoolCourseId String?
  courseId       String?
  reasonEn       String?
  reasonAr       String?
  locked         Boolean @default(false)

  plan StudentCoursePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([orgId, planId])
}

/// Where a requirement came from. Every requirement version points at a source.
model RequirementSource {
  id           String       @id @default(cuid())
  orgId        String?
  universityId String
  programId    String?
  url          String
  title        String?
  sourceType   String
  status       SourceStatus @default(PENDING)
  retrievedAt  DateTime?
  contentHash  String?
  lastError    String?
  createdAt    DateTime     @default(now())

  extractions RequirementExtraction[]

  @@index([universityId])
  @@index([programId])
}

model RequirementExtraction {
  id             String           @id @default(cuid())
  orgId          String?
  sourceId       String
  rawText        String
  normalizedJson Json
  confidence     Float
  model          String
  status         ExtractionStatus @default(PENDING_REVIEW)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())

  source RequirementSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

/// One version of a program's entry requirements for an intake year and (optionally) one curriculum.
/// Versions are never overwritten: a change creates a new row and closes the old one.
model ProgramRequirement {
  id              String            @id @default(cuid())
  orgId           String?
  programId       String
  intakeYear      Int
  curriculum      SchoolCurriculum?
  version         Int               @default(1)
  isCurrent       Boolean           @default(true)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  confidence      DataConfidence    @default(UNKNOWN)
  sourceId        String?
  extractionId    String?
  verifiedAt      DateTime?
  verifiedById    String?
  minimumGPA      Float?
  minimumPercent  Float?
  minimumPoints   Int?
  gradeProfile    String?
  stream          String?
  notesEn         String?
  notesAr         String?
  /// Where on the source page the requirements were found (heading or section).
  evidenceLocator String?
  createdAt       DateTime          @default(now())

  subjects   SubjectRequirement[]
  languages  LanguageRequirement[]
  tests      TestRequirement[]
  additional AdditionalRequirement[]

  @@index([programId, isCurrent])
  @@index([orgId])
}

model SubjectRequirement {
  id                   String                 @id @default(cuid())
  orgId                String?
  programRequirementId String
  type                 SubjectRequirementType
  canonicalSubjectKeys String[]
  minimumLevel         SubjectLevel?
  minimumGrade         String?
  alternatives         String[]
  noteEn               String?
  noteAr               String?

  /// The official page this line was taken from, when it differs from the row's source.
  sourceId           String?
  /// Verbatim quote from the source page that supports this line.
  evidenceQuote      String?
  programRequirement ProgramRequirement @relation(fields: [programRequirementId], references: [id], onDelete: Cascade)

  @@index([programRequirementId])
}

model LanguageRequirement {
  id                   String  @id @default(cuid())
  orgId                String?
  programRequirementId String
  test                 String
  minOverall           Float
  minComponent         Float?
  waiverNoteEn         String?

  /// The official page this line was taken from, when it differs from the row's source.
  sourceId           String?
  /// Verbatim quote from the source page that supports this line.
  evidenceQuote      String?
  programRequirement ProgramRequirement @relation(fields: [programRequirementId], references: [id], onDelete: Cascade)

  @@index([programRequirementId])
}

model TestRequirement {
  id                   String  @id @default(cuid())
  orgId                String?
  programRequirementId String
  test                 String
  policy               String
  minScore             Float?
  noteEn               String?

  /// The official page this line was taken from, when it differs from the row's source.
  sourceId           String?
  /// Verbatim quote from the source page that supports this line.
  evidenceQuote      String?
  programRequirement ProgramRequirement @relation(fields: [programRequirementId], references: [id], onDelete: Cascade)

  @@index([programRequirementId])
}

model AdditionalRequirement {
  id                   String  @id @default(cuid())
  orgId                String?
  programRequirementId String
  kind                 String
  required             Boolean @default(true)
  noteEn               String?
  noteAr               String?

  /// The official page this line was taken from, when it differs from the row's source.
  sourceId           String?
  /// Verbatim quote from the source page that supports this line.
  evidenceQuote      String?
  programRequirement ProgramRequirement @relation(fields: [programRequirementId], references: [id], onDelete: Cascade)

  @@index([programRequirementId])
}

/// A detected difference between two requirement versions, waiting for someone to review it.
model RequirementChange {
  id            String       @id @default(cuid())
  orgId         String?
  programId     String
  fromVersionId String?
  toVersionId   String?
  summaryEn     String
  diff          Json
  status        ChangeStatus @default(NEEDS_REVIEW)
  reviewedById  String?
  detectedAt    DateTime     @default(now())

  @@index([programId])
}

/// Cached result of matching a student (and optionally a plan) against a program's current requirements.
model RequirementMatch {
  id                   String      @id @default(cuid())
  orgId                String
  studentId            String
  programId            String
  planId               String?
  status               MatchStatus
  requiredSatisfied    Int         @default(0)
  requiredMissing      Int         @default(0)
  recommendedSatisfied Int         @default(0)
  detail               Json
  inputsHash           String
  computedAt           DateTime    @default(now())

  @@unique([studentId, programId, planId])
  @@index([orgId, studentId])
}

/// How much adding a course would change a student's options. Recomputed when inputs change.
model CourseImpactAnalysis {
  id         String   @id @default(cuid())
  orgId      String
  studentId  String
  planId     String?
  courseId   String
  unlocks    Int      @default(0)
  improves   Int      @default(0)
  requiredBy Int      @default(0)
  detail     Json
  inputsHash String
  computedAt DateTime @default(now())

  @@index([orgId, studentId])
}

model Application {
  id           String           @id @default(cuid())
  orgId        String
  studentId    String
  programId    String?
  universityId String
  intakeYear   Int
  stage        ApplicationStage @default(RESEARCHING)
  route        String?
  decisionPlan String?
  counselorId  String?
  notes        String?
  submittedAt  DateTime?
  decidedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  items ApplicationRequirement[]

  @@index([orgId, studentId])
}

model ApplicationRequirement {
  id            String                @id @default(cuid())
  orgId         String
  applicationId String
  kind          String
  titleEn       String
  titleAr       String
  status        ApplicationItemStatus @default(TODO)
  dueAt         DateTime?
  taskId        String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([orgId, applicationId])
}

model ApplicationDeadline {
  id           String   @id @default(cuid())
  orgId        String?
  universityId String?
  programId    String?
  intakeYear   Int
  kind         String
  date         DateTime
  sourceId     String?
  noteEn       String?
  createdAt    DateTime @default(now())

  @@index([programId, intakeYear])
  @@index([universityId, intakeYear])
}

// ---------------------------------------------------------------------------
// Self-serve onboarding: invitations and join requests
// ---------------------------------------------------------------------------

enum InviteKind {
  STAFF
  PARENT
  STUDENT
}

/// A personal invitation (with an email) or a shareable join link (no email, several uses).
/// Only a hash of the token is stored.
model Invitation {
  id           String     @id @default(cuid())
  orgId        String
  kind         InviteKind
  email        String?
  nameEn       String?
  roleKeys     String[]
  studentIds   String[]
  tokenHash    String     @unique
  maxUses      Int        @default(1)
  uses         Int        @default(0)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdById  String
  lastSentAt   DateTime?
  acceptedById String?
  createdAt    DateTime   @default(now())

  @@index([orgId, kind])
  @@index([orgId, email])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Someone who joined with the school code or a staff email domain and is waiting for approval.
model JoinRequest {
  id              String            @id @default(cuid())
  orgId           String
  membershipId    String
  kind            InviteKind
  /// For parents: the children they claim, with the details they entered to verify.
  claimedStudents Json?
  note            String?
  status          JoinRequestStatus @default(PENDING)
  decidedById     String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime          @default(now())

  @@index([orgId, status])
}

// ---------------------------------------------------------------------------
// School groups (platform level): one operator running several schools.
// No orgId on group tables: they are protected by user-scoped policies in prisma/rls.sql.
// SchoolGroupSchool carries orgId (the member school) and has its own policy.
// ---------------------------------------------------------------------------

enum GroupRole {
  ADMIN
  VIEWER
}

model SchoolGroup {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameEn      String
  nameAr      String
  logoUrl     String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schools SchoolGroupSchool[]
  members GroupMember[]
  invites GroupInvite[]
  pushes  GroupTemplatePush[]
}

/// A school's membership of a group. A school belongs to at most one group.
model SchoolGroupSchool {
  id        String   @id @default(cuid())
  groupId   String
  orgId     String   @unique
  /// "platform" (assigned by a platform admin) or "invite" (the school accepted a group invite code).
  via       String   @default("platform")
  addedById String?
  joinedAt  DateTime @default(now())

  group SchoolGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

/// A person's role in a group. They may or may not also hold a membership in each school.
model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(VIEWER)
  titleEn   String?
  titleAr   String?
  createdAt DateTime  @default(now())

  group SchoolGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

/// Single-use code a group admin hands to a school. Only a hash of the code is stored.
model GroupInvite {
  id          String    @id @default(cuid())
  groupId     String
  codeHash    String    @unique
  codeHint    String
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedByOrgId String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  group SchoolGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

/// Configuration pushed from one member school to others. Each target school also gets an AuditEvent.
model GroupTemplatePush {
  id           String   @id @default(cuid())
  groupId      String
  sourceOrgId  String
  kind         String
  sourceId     String
  labelEn      String
  labelAr      String
  targetOrgIds String[]
  results      Json
  pushedById   String
  createdAt    DateTime @default(now())

  group SchoolGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

// ---------------------------------------------------------------------------
// Inspection evidence pack
// ---------------------------------------------------------------------------

/// Which evidence heading relates to which area of a regulator's inspection framework.
/// Seeded with defaults (src/server/inspection/mapping.ts) that the school must check against its
/// current framework; stored as data so it can be edited without a code change.
model InspectionMapping {
  id         String    @id @default(cuid())
  orgId      String
  headingKey String
  framework  Regulator
  areaEn     String
  areaAr     String
  noteEn     String?
  noteAr     String?
  sortOrder  Int       @default(0)
  customized Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([orgId, headingKey, framework])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Career events (university visits, fairs, info sessions) and partner resources
// ---------------------------------------------------------------------------

enum CareerEventKind {
  UNIVERSITY_VISIT
  FAIR
  INFO_SESSION
}

enum CareerEventStatus {
  PUBLISHED
  CANCELLED
}

enum CareerRegistrationStatus {
  REGISTERED
  CANCELLED
}

model CareerEvent {
  id                   String            @id @default(cuid())
  orgId                String
  kind                 CareerEventKind
  status               CareerEventStatus @default(PUBLISHED)
  titleEn              String
  titleAr              String
  descEn               String?
  descAr               String?
  /// Universities from the catalog (global or the school's own).
  universityIds        String[]
  /// Universities typed in by staff when they are not in the catalog.
  otherUniversities    String[]
  startsAt             DateTime
  endsAt               DateTime
  locationEn           String?
  locationAr           String?
  onlineUrl            String?
  gradeLevels          Int[]
  capacity             Int?
  registrationDeadline DateTime?
  organizerId          String
  calendarEventId      String?
  cancelledAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  registrations CareerEventRegistration[]

  @@index([orgId, startsAt])
}

model CareerEventRegistration {
  id                   String                   @id @default(cuid())
  orgId                String
  eventId              String
  studentId            String
  status               CareerRegistrationStatus @default(REGISTERED)
  registeredById       String
  registeredAt         DateTime                 @default(now())
  cancelledAt          DateTime?
  attended             Boolean?
  attendanceMarkedAt   DateTime?
  attendanceMarkedById String?

  event CareerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([orgId, studentId])
}

/// Links to external partner providers shown on the career pages. Clicks are counted in aggregate only.
model PartnerResource {
  id          String   @id @default(cuid())
  orgId       String
  nameEn      String
  nameAr      String
  descEn      String
  descAr      String
  category    String
  url         String
  /// "student" and/or "parent"
  audience    String[]
  active      Boolean  @default(true)
  /// Generic demo examples, labelled as examples in the UI.
  isExample   Boolean  @default(false)
  clickCount  Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, active])
}

// ---------------------------------------------------------------------------
// Integrations: school API keys and scheduled sync from a file export
// ---------------------------------------------------------------------------

/// A school's API key. Only a SHA-256 hash of the key is stored; the key is shown once when created.
model ApiKey {
  id            String    @id @default(cuid())
  orgId         String
  label         String
  /// The first characters of the key, shown so people can tell keys apart.
  prefix        String
  keyHash       String    @unique
  /// "<area>:read" or "<area>:write" (write includes read). Areas: students, staff, classes, attendance.
  scopes        String[]
  createdById   String
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  useCount      Int       @default(0)
  /// Requests since the last usage audit event (usage is audited once per hour per key, not per request).
  unauditedUses Int       @default(0)
  lastAuditAt   DateTime?
  revokedAt     DateTime?
  revokedById   String?

  @@index([orgId])
}

/// A file export the worker fetches on a schedule and imports through the Import center services.
model SyncSource {
  id                  String    @id @default(cuid())
  orgId               String
  name                String
  /// staff, students, classes or enrollments
  kind                String
  url                 String
  /// NONE, BASIC or BEARER
  authType            String    @default("NONE")
  /// Encrypted with the field encryption key (src/lib/crypto.ts). Never sent to the browser.
  secretEnc           String?
  /// Header in the school's export (normalized) to Import center column key. Empty: template headers.
  mapping             Json?
  /// HOURLY or DAILY
  schedule            String    @default("DAILY")
  /// Hour of the day (school time zone) for daily runs.
  hour                Int       @default(2)
  enabled             Boolean   @default(true)
  lastSlot            String?
  lastRunAt           DateTime?
  lastStatus          String?
  consecutiveFailures Int       @default(0)
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  runs SyncRun[]

  @@index([orgId])
}

/// One run of a sync source. (sourceId, slot) is the idempotency key: one run per schedule slot.
/// Holds counts and an error code only, never cell values.
model SyncRun {
  id         String    @id @default(cuid())
  orgId      String
  sourceId   String
  slot       String
  /// SCHEDULE or MANUAL
  trigger    String
  /// QUEUED, RUNNING, SUCCEEDED, PARTIAL or FAILED
  status     String    @default("RUNNING")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  total      Int       @default(0)
  created    Int       @default(0)
  updated    Int       @default(0)
  unchanged  Int       @default(0)
  failed     Int       @default(0)
  errorCode  String?
  importId   String?
  actorId    String?

  source SyncSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, slot])
  @@index([orgId, startedAt])
}

// ---------------------------------------------------------------------------
// Platform marketing and operations (no orgId: these are not school data).
// Only the owner role may touch MarketingLead and PlatformSetting (prisma/rls.sql revokes app_user);
// app_user may only read UptimeSample for the public status page.
// ---------------------------------------------------------------------------

enum MarketingLeadType {
  TASTER
  OFFER
}

enum MarketingLeadRole {
  STUDENT
  PARENT
  STAFF
}

enum LeadEmailStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// A marketing lead from the public site: someone who asked for a career taster result or a school offer.
/// Holds only what the visitor typed, with their consent time and the page it came from.
model MarketingLead {
  id             String            @id @default(cuid())
  type           MarketingLeadType
  /// Page the lead came from: "try" or "pricing".
  source         String
  name           String
  email          String
  role           MarketingLeadRole
  schoolName     String?
  locale         Locale            @default(en)
  consentAt      DateTime
  /// Version of the consent wording the visitor agreed to.
  consentVersion String
  /// Taster: answers, scores and top areas. Offer: the estimator inputs.
  payload        Json
  emailStatus    LeadEmailStatus   @default(QUEUED)
  emailSentAt    DateTime?
  createdAt      DateTime          @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}

/// Platform-wide settings edited by platform admins (for example pricing). Key-value, JSON values.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// One row per 5-minute slot, written by the worker. Feeds the 90-day history on /status.
model UptimeSample {
  /// Start of the 5-minute slot in UTC. The primary key makes each slot's write idempotent.
  slot      DateTime @id
  web       Boolean?
  database  Boolean
  redis     Boolean
  worker    Boolean
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Admissions, enrollment, re-enrollment and withdrawals (src/server/admissions).
// Families apply before they belong to the school: an application is owned by a global User
// (applicantUserId) and families only ever read their own. Staff access is permission-checked
// (admissions.view, admissions.manage, admissions.enroll). Health and support details are encrypted
// and follow the medical access rules (people.medical), with an audit event on every view.
// ---------------------------------------------------------------------------

/// One row per school, created on first use.
model AdmissionSettings {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  /// Families can start an application at /apply/<school slug>.
  publicOpen         Boolean  @default(false)
  /// Academic years open for applications. Empty means the current year and the next one.
  openYearIds        String[]
  /// Age cut-off (month and day). KG1 is age 4, KG2 age 5 and Grade 1 age 6 on this date in the year of entry.
  cutoffMonth        Int      @default(12)
  cutoffDay          Int      @default(31)
  /// Admission number pattern, for example "{YY}{SEQ:4}". See src/server/admissions/numbers.ts.
  admissionNoPattern String   @default("{YYYY}-{SEQ:4}")
  /// Days a family has to accept an offer.
  offerDays          Int      @default(14)
  /// Document types families upload (src/server/admissions/config.ts). Null means the defaults.
  documentTypes      Json?
  /// Stage labels, hidden optional stages and custom review stages. Null means the defaults.
  stages             Json?
  introEn            String?
  introAr            String?
  /// Government registration authority (src/server/admissions/registration.ts): SPEA_DALEEL, MOE_MANHAL, KHDA, ADEK
  /// or OTHER. Null means the default for the school's regulator. The labels override the shown name.
  authority          String?
  authorityLabelEn   String?
  authorityLabelAr   String?
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Places per grade for one academic year, by section, and the seat booking amount in fils (AED x 100).
model AdmissionCapacity {
  id             String   @id @default(cuid())
  orgId          String
  academicYearId String
  gradeLevel     Int
  /// Seats per section in section order (A, B, C ...).
  sectionSeats   Int[]
  /// Seat booking amount in fils. 0 means no seat booking fee for this grade.
  seatFeeFils    Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([orgId, academicYearId, gradeLevel])
}

/// One application for one child, a draft until the family submits it.
model AdmissionApplication {
  id                      String            @id @default(cuid())
  orgId                   String
  number                  String
  /// The family account (global User) that applies. Families only ever read their own applications.
  applicantUserId         String
  academicYearId          String
  gradeLevel              Int
  curriculum              SchoolCurriculum?
  /// Stage key (src/server/admissions/stages.ts), or a school's own review stage.
  stage                   String            @default("DRAFT")
  stageChangedAt          DateTime          @default(now())
  submittedAt             DateTime?
  /// ONLINE (family) or STAFF (entered by the admissions office).
  source                  String            @default("ONLINE")
  /// Last wizard step the family saved.
  step                    String?
  firstNameEn             String            @default("")
  lastNameEn              String            @default("")
  firstNameAr             String?
  lastNameAr              String?
  dateOfBirth             DateTime?
  gender                  String?
  /// ISO 3166 country code.
  nationality             String?
  homeLanguage            String?
  emiratesIdEnc           String?
  emiratesIdLast4         String?
  /// Keyed hash of the Emirates ID digits, only for duplicate detection.
  emiratesIdHash          String?
  passportEnc             String?
  passportLast4           String?
  /// Normalised English name and date of birth, only for duplicate detection.
  nameDobKey              String?
  /// Previous schooling, guardians and siblings as the family entered them (validated in src/server/admissions/form.ts).
  schooling               Json?
  guardians               Json?
  siblings                Json?
  /// Current students the school matched as siblings.
  siblingStudentIds       String[]
  /// A parent works at the school: declared by the family, verified by staff.
  staffChild              Boolean           @default(false)
  staffChildVerified      Boolean           @default(false)
  /// Extra waitlist priority set by staff (the reason is in the application history).
  priorityBoost           Int               @default(0)
  /// Health and learning support details: encrypted JSON (people.medical only, every view audited).
  medicalEnc              String?
  supportEnc              String?
  hasMedical              Boolean           @default(false)
  hasSupport              Boolean           @default(false)
  consentAt               DateTime?
  assessmentAppointmentId String?
  /// RECOMMENDED, CONDITIONAL or NOT_RECOMMENDED.
  assessmentOutcome       String?
  assessmentNotes         String?
  offerSection            String?
  offerMadeAt             DateTime?
  offerDeadline           DateTime?
  offerRespondedAt        DateTime?
  seatFeeFils             Int?
  /// Reference of a seat booking charge created by the fees module (src/server/admissions/seat-booking.ts).
  seatChargeRef           String?
  seatPayUrl              String?
  seatPaidAt              DateTime?
  seatPaymentRef          String?
  /// SCHOOL or FAMILY, for declined and withdrawn applications.
  closedBy                String?
  closeReason             String?
  waitlistedAt            DateTime?
  /// Possible duplicates found on submit, for example "eid:application:<id>" or "namedob:student:<id>".
  duplicateFlags          String[]
  studentId               String?
  enrolledAt              DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  documents AdmissionDocument[]
  messages  AdmissionMessage[]
  events    AdmissionEvent[]

  @@unique([orgId, number])
  @@index([orgId, academicYearId, gradeLevel, stage])
  @@index([orgId, stage, stageChangedAt])
  @@index([orgId, applicantUserId])
  @@index([orgId, emiratesIdHash])
  @@index([orgId, nameDobKey])
  @@index([orgId, studentId])
}

/// A file a family uploaded for an application. Stored under the school's prefix, served only after an access check.
model AdmissionDocument {
  id                     String   @id @default(cuid())
  orgId                  String
  applicationId          String
  typeKey                String
  fileName               String
  mimeType               String
  sizeBytes              Int
  storageKey             String
  checksum               String
  /// RECEIVED, ACCEPTED or REJECTED (staff review).
  status                 String   @default("RECEIVED")
  reviewNote             String?
  uploadedByUserId       String?
  uploadedByMembershipId String?
  createdAt              DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([orgId, applicationId])
}

/// Conversation on an application. SHARED messages reach the family; STAFF notes never do.
model AdmissionMessage {
  id                 String            @id @default(cuid())
  orgId              String
  applicationId      String
  /// Staff author, or null when the family wrote it (authorUserId).
  authorMembershipId String?
  authorUserId       String?
  visibility         MessageVisibility @default(SHARED)
  body               String
  createdAt          DateTime          @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([orgId, applicationId, createdAt])
}

/// Application history: stage changes, offers, payments, document reviews. Feeds the funnel report.
model AdmissionEvent {
  id                String   @id @default(cuid())
  orgId             String
  applicationId     String
  kind              String
  fromStage         String?
  toStage           String?
  actorMembershipId String?
  actorUserId       String?
  data              Json?
  createdAt         DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([orgId, applicationId, createdAt])
  @@index([orgId, toStage])
}

/// A re-enrollment window: families confirm, per child, whether they return next year.
model ReenrollmentWindow {
  id             String    @id @default(cuid())
  orgId          String
  /// The year families confirm for (normally next year).
  academicYearId String
  opensAt        DateTime
  closesAt       DateTime
  closedAt       DateTime?
  messageEn      String?
  messageAr      String?
  /// Automatic reminders to non-responders this many days before the window closes.
  reminderDays   Int[]
  createdById    String
  createdAt      DateTime  @default(now())

  responses ReenrollmentResponse[]

  @@index([orgId, academicYearId])
}

model ReenrollmentResponse {
  id            String    @id @default(cuid())
  orgId         String
  windowId      String
  studentId     String
  /// RETURNING or LEAVING.
  intent        String
  reasonKey     String?
  reasonNote    String?
  leavingDate   DateTime?
  respondedById String
  respondedAt   DateTime
  withdrawalId  String?

  window ReenrollmentWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)

  @@unique([windowId, studentId])
  @@index([orgId, windowId, intent])
}

/// A student leaving the school: leaving date, reason and the transfer certificate.
model StudentWithdrawal {
  id            String    @id @default(cuid())
  orgId         String
  studentId     String
  leavingDate   DateTime
  reasonKey     String
  reasonNote    String?
  destination   String?
  /// PLANNED, COMPLETED or CANCELLED.
  status        String    @default("PLANNED")
  /// STAFF or REENROLLMENT.
  source        String    @default("STAFF")
  tcNumber      String?
  tcIssuedAt    DateTime?
  tcDocumentId  String?
  createdById   String
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orgId, status, leavingDate])
  @@index([orgId, studentId])
}

/// Registration of a learner with the education authority (for example SPEA DALEEL in Sharjah): one row when a
/// student is enrolled (ENROLLMENT) and one when a student leaves (WITHDRAWAL). There is no public API, so staff
/// record the status, the authority's reference number and the decision date by hand.
model GovRegistration {
  id            String    @id @default(cuid())
  orgId         String
  studentId     String
  /// ENROLLMENT or WITHDRAWAL.
  kind          String
  /// NOT_SUBMITTED, SUBMITTED, APPROVED or REJECTED.
  status        String    @default("NOT_SUBMITTED")
  /// Authority key at the time the row was created.
  authority     String
  reference     String?
  submittedAt   DateTime?
  decidedAt     DateTime?
  note          String?
  applicationId String?
  withdrawalId  String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orgId, kind, status])
  @@index([orgId, studentId])
}

// ---------------------------------------------------------------------------
// Sign-in options and rostering (src/server/sso, src/server/rostering)
// ---------------------------------------------------------------------------

/// How people sign in to one school. Provider credentials live in environment variables; the only secret kept
/// here is the school's own identity provider client secret, encrypted with FIELD_ENCRYPTION_KEY.
model SignInPolicy {
  id                String   @id @default(cuid())
  orgId             String   @unique
  /// Options on the school's sign-in page: password, magic_link, google, microsoft, classlink, clever, oidc, uaepass.
  methods           String[]
  /// Staff must use single sign-on. School administrators keep password sign-in so the school cannot lock itself out.
  staffSsoRequired  Boolean  @default(false)
  /// Staff and student single sign-on is accepted only for these email domains (empty: any domain).
  allowedDomains    String[]
  /// EMAIL, EXTERNAL_ID or EMAIL_OR_EXTERNAL_ID: how a first single sign-on finds the existing member.
  matchBy           String   @default("EMAIL_OR_EXTERNAL_ID")
  /// Unknown people with a verified address on these domains may join through single sign-on.
  selfJoinDomains   String[]
  selfJoinApproval  Boolean  @default(true)
  classlinkTenantId String?
  cleverDistrictId  String?
  microsoftTenantId String?
  oidcName          String?
  oidcIssuer        String?
  oidcClientId      String?
  oidcSecretEnc     String?
  oidcScopes        String   @default("openid email profile")
  oidcEmailClaim    String   @default("email")
  oidcIdClaim       String   @default("sub")
  oidcNameClaim     String   @default("name")
  /// The school's own directory issues these addresses, so they count as verified even without email_verified.
  oidcTrustEmail    Boolean  @default(false)
  /// UAE PASS: match a first sign-in by the Emirates ID on the student record (compared by hash, never stored).
  uaePassEidMatch   Boolean  @default(true)
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([classlinkTenantId])
  @@unique([cleverDistrictId])
}

/// A single sign-on identity linked to a member of one school. Never shared across schools.
model SsoIdentity {
  id           String    @id @default(cuid())
  orgId        String
  membershipId String
  /// classlink, clever, google, microsoft, oidc or uaepass
  provider     String
  /// The provider's stable subject for the person (for UAE PASS the uuid).
  subject      String
  /// How the first sign-in found the member: email, external_id, emirates_id, self_join or admin.
  linkedVia    String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([orgId, provider, subject])
  @@index([orgId, membershipId])
}

/// A rostering source: ClassLink Roster Server, Clever or another OneRoster server.
model RosterConnection {
  id                  String    @id @default(cuid())
  orgId               String
  /// classlink, clever or oneroster
  provider            String
  name                String
  /// OneRoster base URL (ending in /ims/oneroster/v1p1 or /ims/oneroster/rostering/v1p2). Clever uses its own API.
  baseUrl             String?
  /// OAUTH1 (OneRoster 1.1), OAUTH2 (client credentials, OneRoster 1.2) or BEARER (Clever district token, proxies).
  authMode            String    @default("OAUTH1")
  tokenUrl            String?
  /// Encrypted JSON with the key and secret or token. Never sent to the browser.
  credentialsEnc      String?
  /// School sourcedIds (or Clever school ids) to import. Empty: every school in the feed.
  schoolIds           String[]
  /// Import options, grade code map and role map (see src/lib/rostering/options.ts).
  options             Json?
  /// OFF, DAILY or HOURLY
  schedule            String    @default("OFF")
  hour                Int       @default(3)
  enabled             Boolean   @default(true)
  lastSlot            String?
  lastRunAt           DateTime?
  lastStatus          String?
  /// High-water mark for incremental OneRoster pulls (start time of the last applied run).
  lastDeltaAt         DateTime?
  consecutiveFailures Int       @default(0)
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  runs RosterRun[]

  @@index([orgId])
}

/// One roster preview or sync. Resumable: the cursor says which page or batch comes next.
model RosterRun {
  id              String    @id @default(cuid())
  orgId           String
  connectionId    String?
  provider        String
  /// API or CSV
  source          String    @default("API")
  /// MANUAL, SCHEDULE or UPLOAD
  trigger         String
  /// FULL or DELTA
  mode            String    @default("FULL")
  dryRun          Boolean   @default(true)
  /// QUEUED, FETCHING, PLANNING, PREVIEWED, APPLYING, SUCCEEDED, PARTIAL, FAILED, BLOCKED or EXPIRED
  status          String    @default("QUEUED")
  phase           String?
  slot            String?
  cursor          Json?
  counts          Json?
  issues          Json?
  changes         Json?
  progressDone    Int       @default(0)
  progressTotal   Int       @default(0)
  allowMassDelete Boolean   @default(false)
  errorCode       String?
  actorId         String?
  heartbeatAt     DateTime?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  appliedAt       DateTime?

  connection RosterConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([connectionId, slot])
  @@index([orgId, startedAt])
  @@index([status, heartbeatAt])
}

/// Staged source records of one run. Deleted when the run is applied or expires.
model RosterRecord {
  id         String @id @default(cuid())
  orgId      String
  runId      String
  /// org, session, user, class, enrollment or demographics
  kind       String
  externalId String
  data       Json
  hash       String

  @@unique([runId, kind, externalId])
  @@index([orgId, runId, kind])
}

/// Which local record a roster source record became. Later syncs update it, and only remove what they added.
model RosterLink {
  id            String    @id @default(cuid())
  orgId         String
  provider      String
  /// student, staff, guardian, class, enrollment or guardianLink
  kind          String
  externalId    String
  localId       String
  /// Hash of the source fields last applied, so unchanged records are skipped.
  hash          String
  lastSeenRunId String?
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([orgId, provider, kind, externalId])
  @@index([orgId, kind, localId])
}

// ---------------------------------------------------------------------------
// Fees and invoicing (src/server/fees, src/server/payments).
// Money is always an integer number of fils (1 AED = 100 fils). Issued invoices, credit notes, payments and
// allocations are never edited or deleted by the app (see prisma/rls.sql): corrections are credit notes.
// ---------------------------------------------------------------------------

enum FeeItemKind {
  TUITION
  REGISTRATION
  REENROLLMENT
  SEAT_DEPOSIT
  TRANSPORT
  UNIFORM
  BOOKS
  TRIP
  EXAM
  OTHER
}

enum VatTreatment {
  ZERO_RATED
  STANDARD
  EXEMPT
  OUT_OF_SCOPE
}

enum InstalmentPlanKind {
  ANNUAL
  TERMLY
  MONTHLY
  CUSTOM
}

enum FeeDiscountKind {
  SIBLING
  STAFF_CHILD
  SCHOLARSHIP
  BURSARY
  EARLY_PAYMENT
  OTHER
}

enum DiscountMethod {
  PERCENT
  FIXED
}

enum DiscountStacking {
  STACK
  BEST_ONLY
}

enum FeeAwardStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum FeePayerType {
  GUARDIAN
  SPONSOR
}

enum InvoiceKind {
  PROFORMA
  TAX
}

enum InvoiceStatus {
  OPEN
  PARTIAL
  PAID
  CREDITED
  CANCELLED
  CONVERTED
}

enum FeePaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  CARD
  ONLINE
}

enum FeePaymentStatus {
  HELD
  CLEARED
  BOUNCED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

enum PaymentLinkStatus {
  OPEN
  PAID
  EXPIRED
  CANCELLED
}

enum BillingRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProRataBasis {
  MONTH
  DAY
  TERM
  NONE
}

/// One row per school: legal identity for tax invoices, numbering, discounts, pro rata, reminders, finance hold.
model FinanceSettings {
  id                 String           @id @default(cuid())
  orgId              String           @unique
  legalNameEn        String?
  legalNameAr        String?
  addressEn          String?
  addressAr          String?
  /// UAE Tax Registration Number (15 digits). Required before tax invoices are issued while VAT registered.
  trn                String?
  vatRegistered      Boolean          @default(true)
  /// Standard VAT rate in basis points (500 = 5%).
  standardVatBp      Int              @default(500)
  invoicePrefix      String           @default("INV")
  proformaPrefix     String           @default("PF")
  creditNotePrefix   String           @default("CN")
  receiptPrefix      String           @default("RCT")
  refundPrefix       String           @default("RF")
  paymentTermsDays   Int              @default(14)
  siblingSecondBp    Int              @default(500)
  siblingThirdBp     Int              @default(1000)
  siblingFourthBp    Int              @default(1000)
  discountStacking   DiscountStacking @default(STACK)
  earlyPaymentBp     Int              @default(0)
  earlyPaymentDays   Int              @default(0)
  proRataBasis       ProRataBasis     @default(MONTH)
  proRataCutoffDay   Int              @default(15)
  remindersEnabled   Boolean          @default(true)
  reminderDaysBefore Int              @default(7)
  reminderDaysAfter  Int[]            @default([7, 21, 45])
  /// Finance hold: report card downloads wait until overdue fees are settled. Off by default.
  holdReportCards    Boolean          @default(false)
  holdAfterDays      Int              @default(30)
  /// The school switched online payment on (the platform must also have a payment provider configured).
  onlinePayments     Boolean          @default(false)
  bankDetailsEn      String?
  bankDetailsAr      String?
  updatedAt          DateTime         @updatedAt
}

/// A fee in one academic year: tuition for a grade, transport for a zone, or a one-off item.
model FeeItem {
  id             String       @id @default(cuid())
  orgId          String
  academicYearId String
  code           String
  kind           FeeItemKind
  nameEn         String
  nameAr         String
  /// Annual amount for recurring items, unit price for one-off items.
  amountFils     Int
  /// Grades this item applies to (empty means every grade). Tuition has one grade per item.
  gradeLevels    Int[]
  /// Transport zone code (transport items only).
  zone           String?
  /// Split across the instalment plan (tuition, transport).
  recurring      Boolean      @default(false)
  proRata        Boolean      @default(false)
  /// Sibling, staff and award discounts apply.
  discountable   Boolean      @default(false)
  /// Billed automatically in a billing run (tuition by grade, transport by zone).
  autoBill       Boolean      @default(false)
  vatTreatment   VatTreatment
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([orgId, academicYearId, code])
  @@index([orgId, academicYearId, kind])
}

model InstalmentPlan {
  id             String             @id @default(cuid())
  orgId          String
  academicYearId String
  key            String
  nameEn         String
  nameAr         String
  kind           InstalmentPlanKind
  isDefault      Boolean            @default(false)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())

  parts InstalmentPart[]

  @@unique([orgId, academicYearId, key])
}

model InstalmentPart {
  id          String   @id @default(cuid())
  orgId       String
  planId      String
  seq         Int
  labelEn     String
  labelAr     String
  dueDate     DateTime
  periodStart DateTime
  periodEnd   DateTime
  /// Share of the annual amount in basis points (all parts of a plan add up to 10000).
  shareBp     Int

  plan InstalmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, seq])
  @@index([orgId])
}

model FeeDiscount {
  id               String          @id @default(cuid())
  orgId            String
  code             String
  kind             FeeDiscountKind
  nameEn           String
  nameAr           String
  method           DiscountMethod
  percentBp        Int?
  /// Fixed discounts are an annual amount, shared across instalments like the fee itself.
  amountFils       Int?
  requiresApproval Boolean         @default(true)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())

  awards FeeAward[]

  @@unique([orgId, code])
}

/// A discount granted to one student for one academic year (staff child, scholarship, bursary).
model FeeAward {
  id             String         @id @default(cuid())
  orgId          String
  studentId      String
  discountId     String
  academicYearId String
  status         FeeAwardStatus @default(PENDING)
  reason         String?
  requestedById  String?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime       @default(now())

  discount FeeDiscount @relation(fields: [discountId], references: [id], onDelete: Restrict)

  @@index([orgId, studentId, academicYearId])
  @@index([orgId, status])
}

/// A family account: the bill payer (a guardian or a company sponsor) and the children billed together.
model FeeAccount {
  id              String       @id @default(cuid())
  orgId           String
  code            String
  nameEn          String
  nameAr          String
  payerType       FeePayerType @default(GUARDIAN)
  payerGuardianId String?
  sponsorName     String?
  sponsorTrn      String?
  /// Billing address and email (the sponsor's for a company, otherwise the payer's own).
  billingAddress  String?
  billingEmail    String?
  /// Instalment plan key chosen by the family (null means the school's default plan).
  planKey         String?
  remindersPaused Boolean      @default(false)
  pausedReason    String?
  /// Admissions applicant (seat booking) accounts have no enrolled children yet.
  applicationRef  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  students StudentFeeProfile[]

  @@unique([orgId, code])
  @@index([orgId, payerGuardianId])
  @@index([orgId, applicationRef])
  @@index([orgId, nameEn])
}

model StudentFeeProfile {
  id            String   @id @default(cuid())
  orgId         String
  studentId     String   @unique
  accountId     String
  transportZone String?
  createdAt     DateTime @default(now())

  account FeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([orgId, accountId])
}

/// A one-off charge (uniform, books, trip, exam fee) waiting to be invoiced, or already on an invoice.
model FeeCharge {
  id            String   @id @default(cuid())
  orgId         String
  accountId     String
  studentId     String?
  feeItemId     String
  quantity      Int      @default(1)
  unitFils      Int
  descriptionEn String?
  descriptionAr String?
  invoiceId     String?
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([orgId, accountId, invoiceId])
}

/// A proforma (request for payment, not a tax document) or a tax invoice. Never edited once issued.
model Invoice {
  id             String        @id @default(cuid())
  orgId          String
  kind           InvoiceKind
  number         String
  accountId      String
  academicYearId String?
  billingRunId   String?
  planPartId     String?
  status         InvoiceStatus @default(OPEN)
  issueDate      DateTime
  dueDate        DateTime
  periodStart    DateTime?
  periodEnd      DateTime?
  periodLabelEn  String?
  periodLabelAr  String?
  billToName     String
  billToNameAr   String?
  billToAddress  String?
  billToTrn      String?
  billToEmail    String?
  /// The school's legal name, address and TRN at the time of issue.
  seller         Json
  subtotalFils   Int
  discountFils   Int
  netFils        Int
  vatFils        Int
  totalFils      Int
  paidFils       Int           @default(0)
  creditedFils   Int           @default(0)
  /// A proforma converted to a tax invoice points to it.
  convertedToId  String?
  sourceRef      String?
  remindersSent  Int           @default(0)
  lastReminderAt DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())

  lines InvoiceLine[]

  @@unique([orgId, number])
  @@unique([billingRunId, accountId])
  @@index([orgId, accountId, issueDate])
  @@index([orgId, status, dueDate])
  @@index([orgId, issueDate])
  @@index([orgId, sourceRef])
}

model InvoiceLine {
  id            String       @id @default(cuid())
  orgId         String
  invoiceId     String
  seq           Int
  studentId     String?
  feeItemId     String?
  kind          FeeItemKind
  descriptionEn String
  descriptionAr String
  quantity      Int
  unitFils      Int
  grossFils     Int
  discountFils  Int
  netFils       Int
  vatTreatment  VatTreatment
  vatRateBp     Int
  vatFils       Int
  totalFils     Int
  /// Pro rata units billed out of the period's units (1 of 1 when not pro rata).
  prorataNum    Int          @default(1)
  prorataDen    Int          @default(1)
  /// Discount breakdown: [{ kind, labelEn, labelAr, amountFils }].
  discounts     Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([orgId, invoiceId])
  @@index([orgId, studentId])
}

model CreditNote {
  id          String   @id @default(cuid())
  orgId       String
  number      String
  invoiceId   String
  accountId   String
  issueDate   DateTime
  reasonKind  String
  reasonEn    String
  reasonAr    String?
  netFils     Int
  vatFils     Int
  totalFils   Int
  createdById String?
  createdAt   DateTime @default(now())

  lines CreditNoteLine[]

  @@unique([orgId, number])
  @@index([orgId, accountId])
  @@index([orgId, invoiceId])
  @@index([orgId, issueDate])
}

model CreditNoteLine {
  id            String       @id @default(cuid())
  orgId         String
  creditNoteId  String
  invoiceLineId String?
  descriptionEn String
  descriptionAr String
  netFils       Int
  vatTreatment  VatTreatment
  vatRateBp     Int
  vatFils       Int
  totalFils     Int

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)

  @@index([orgId, creditNoteId])
}

/// Money received. A post-dated cheque is HELD until it clears; the receipt number is given on clearing.
model FeePayment {
  id             String           @id @default(cuid())
  orgId          String
  accountId      String
  number         String?
  method         FeePaymentMethod
  provider       String           @default("manual")
  status         FeePaymentStatus
  amountFils     Int
  allocatedFils  Int              @default(0)
  /// Refunds requested, approved or paid from this payment.
  refundedFils   Int              @default(0)
  receivedAt     DateTime
  clearedAt      DateTime?
  bouncedAt      DateTime?
  reference      String?
  chequeNumber   String?
  chequeBank     String?
  chequeDate     DateTime?
  payerName      String?
  notes          String?
  externalId     String?
  idempotencyKey String
  recordedById   String?
  createdAt      DateTime         @default(now())

  @@unique([orgId, number])
  @@unique([orgId, idempotencyKey])
  @@index([orgId, accountId])
  @@index([orgId, status, chequeDate])
  @@index([orgId, receivedAt])
}

/// Money (a payment or a credit note) applied to an invoice. Append only: a release is a negative row.
model FeeAllocation {
  id           String   @id @default(cuid())
  orgId        String
  invoiceId    String
  paymentId    String?
  creditNoteId String?
  amountFils   Int
  createdAt    DateTime @default(now())

  @@index([orgId, invoiceId])
  @@index([orgId, paymentId])
}

model FeeRefund {
  id            String            @id @default(cuid())
  orgId         String
  number        String?
  accountId     String
  paymentId     String
  amountFils    Int
  reason        String
  status        RefundStatus      @default(REQUESTED)
  requestedById String?
  requestedAt   DateTime          @default(now())
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  paidAt        DateTime?
  method        FeePaymentMethod?
  reference     String?

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, accountId])
}

/// An online payment request sent to a payment provider (or the built-in test checkout).
model PaymentLink {
  id          String            @id @default(cuid())
  orgId       String
  accountId   String
  invoiceId   String?
  amountFils  Int
  currency    String            @default("AED")
  provider    String
  status      PaymentLinkStatus @default(OPEN)
  externalId  String?
  url         String?
  expiresAt   DateTime
  paymentId   String?
  createdById String?
  createdAt   DateTime          @default(now())
  paidAt      DateTime?

  @@index([orgId, invoiceId])
  @@index([orgId, accountId])
}

/// Provider webhook events already handled (idempotency).
model PaymentEvent {
  id        String   @id @default(cuid())
  orgId     String
  provider  String
  eventId   String
  type      String
  linkId    String?
  outcome   String
  createdAt DateTime @default(now())

  @@unique([orgId, provider, eventId])
}

/// Bulk invoicing for one instalment: processed by the worker in batches of family accounts.
model BillingRun {
  id              String           @id @default(cuid())
  orgId           String
  academicYearId  String
  planId          String
  partId          String
  status          BillingRunStatus @default(QUEUED)
  issueDate       DateTime
  dueDate         DateTime
  includeCharges  Boolean          @default(true)
  totalAccounts   Int              @default(0)
  processed       Int              @default(0)
  invoicesCreated Int              @default(0)
  skipped         Int              @default(0)
  totalFils       Int              @default(0)
  /// Last account id processed, so a run resumes where it stopped.
  cursor          String?
  error           String?
  createdById     String?
  createdAt       DateTime         @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  updatedAt       DateTime         @updatedAt

  @@index([orgId, createdAt])
  @@index([status, updatedAt])
}

// ---------------------------------------------------------------------------
// Government reporting (src/server/govreports). Returns built from Horizon data for the school's education
// authority (SPEA, KHDA, ADEK or the Ministry of Education): an enrollment census, a learner registration list,
// attendance, staff and results returns. None of the authorities publishes an API or a public file format, so
// files use a "Horizon standard" layout that staff copy into the authority's portal. Every file generated is
// logged with a version and checksums, submissions record the authority's reference, and staff keep a calendar
// of due dates with reminders. Exports and submissions are append-only.
// ---------------------------------------------------------------------------

/// One return for a census date or a period.
model GovReturn {
  id             String    @id @default(cuid())
  orgId          String
  /// CENSUS, REGISTRATION, ATTENDANCE, STAFF or RESULTS (src/server/govreports/kinds.ts).
  kind           String
  /// Authority key when the return was created (SPEA_DALEEL, MOE_MANHAL, KHDA, ADEK or OTHER).
  authority      String
  /// Census date, or the last day of the period. A calendar date.
  asOf           DateTime  @db.Date
  /// First day of the period (movements, attendance, results, and admissions and leavers on a census).
  periodFrom     DateTime? @db.Date
  /// Optional name the school gives the return, for example "October census".
  label          String?
  /// DRAFT, SIGNED_OFF or SUBMITTED.
  status         String    @default("DRAFT")
  dueDateId      String?
  /// Principal sign-off: who, their title, when, and the data version they signed.
  signedOffById  String?
  signedOffName  String?
  signedOffTitle String?
  signedOffAt    DateTime?
  signedDataHash String?
  signedVersion  Int?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  exports     GovReturnExport[]
  submissions GovSubmission[]

  @@index([orgId, kind, asOf])
  @@index([orgId, status])
}

/// A file generated from a return (Excel, CSV or PDF). The version goes up when the return's data changes.
model GovReturnExport {
  id            String   @id @default(cuid())
  orgId         String
  returnId      String
  version       Int
  /// XLSX, CSV or PDF.
  format        String
  locale        String
  /// SHA-256 (hex) of the file as downloaded, and of the return's data.
  fileSha256    String
  dataSha256    String
  sizeBytes     Int
  rowCount      Int
  /// Validation problems open when the file was generated (the file then carries a warning).
  problemCount  Int      @default(0)
  /// Full Emirates ID numbers were included (needs people.reveal_ids).
  withIds       Boolean  @default(false)
  /// Aggregate totals when the file was generated. Never names or identifiers.
  summary       Json?
  generatedById String
  createdAt     DateTime @default(now())

  return GovReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)

  @@index([orgId, returnId, createdAt])
}

/// A return sent to the authority: which file, when, who recorded it, and the authority's reference.
model GovSubmission {
  id           String   @id @default(cuid())
  orgId        String
  returnId     String
  exportId     String
  submittedOn  DateTime @db.Date
  reference    String
  note         String?
  recordedById String
  createdAt    DateTime @default(now())

  return GovReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)

  @@index([orgId, returnId])
  @@index([orgId, createdAt])
}

/// A due date the school enters for a return (for example the census date). Holders of government.reports are
/// reminded 14 and 3 days before (src/server/govreports/reminders.ts).
model GovDueDate {
  id          String    @id @default(cuid())
  orgId       String
  titleEn     String
  titleAr     String
  /// Return kind it is for (src/server/govreports/kinds.ts), or OTHER.
  kind        String
  dueOn       DateTime  @db.Date
  notes       String?
  /// Set when staff mark it done or a return linked to it is submitted.
  doneAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId, dueOn])
}
