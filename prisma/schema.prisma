}

// ---------------------------------------------------------------------------
// Subject registration and automatic class allocation
// ---------------------------------------------------------------------------

enum OfferingKind {
  CORE
  OPTION
}

enum RegistrationStatus {
  REQUESTED
  ALLOCATED
  WAITLISTED
  DROPPED
}

enum RegistrationSource {
  STUDENT
  PARENT
  STAFF
  IMPORT
  SUBJECT_CHANGE
}

/// A subject offered to a grade in a year: core (everyone) or an option in a block.
model SubjectOffering {
  id             String            @id @default(cuid())
  orgId          String
  academicYearId String
  subjectId      String
  gradeLevel     Int
  kind           OfferingKind      @default(CORE)
  optionBlock    String?
  prerequisites  String[]
  periodsPerWeek Int               @default(4)
  notesEn        String?
  notesAr        String?
  /// The track the offering is for (American, British...). Null: every track.
  curriculum     SchoolCurriculum?
  /// The curriculum course it counts as for universities (CurriculumCourse id), for example AP Calculus BC.
  courseId       String?
  /// An Advanced Placement course.
  isAP           Boolean           @default(false)
  createdAt      DateTime          @default(now())

  // One row per subject, grade and track (a null track means every track; never alongside a track row).
  @@unique([orgId, academicYearId, subjectId, gradeLevel, curriculum])
  @@index([orgId])
}

/// A student's registration for a subject; allocation places them in a class section.
model SubjectRegistration {
  id             String             @id @default(cuid())
  orgId          String
  academicYearId String
  studentId      String
  subjectId      String
  status         RegistrationStatus @default(REQUESTED)
  source         RegistrationSource @default(STAFF)
  classId        String?
  preference     Int                @default(1)
  createdById    String?
  /// When this choice was last made (createdById made it).
  chosenAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([academicYearId, studentId, subjectId])
  @@index([orgId, studentId])
}

// ---------------------------------------------------------------------------
// Course selection: windows, late-change exceptions, class sessions, assisted choosing, sign-off
// ---------------------------------------------------------------------------

/// Whether parents can make course choices for their child.
enum ParentChoiceMode {
  /// Whenever choosing is open.
  ALWAYS
  /// Only after the student, a teacher or an admin allows that parent.
  WHEN_ALLOWED
  /// Parents confirm (sign off) but never choose.
  NEVER
}

/// Course selection rules for one school. Defaults apply until the school saves them.
model CourseSelectionSettings {
  id                   String           @id @default(cuid())
  orgId                String           @unique
  parentChoice         ParentChoiceMode @default(ALWAYS)
  /// A parent confirms the choices once they are submitted.
  signOffRequired      Boolean          @default(false)
  /// When a parent makes the choices, that counts as their own sign-off.
  parentChoiceSignsOff Boolean          @default(true)
  updatedById          String?
  updatedAt            DateTime         @updatedAt
}

/// When students in some grades choose courses for a year. Rounds can follow each other.
model CourseSelectionWindow {
  id              String   @id @default(cuid())
  orgId           String
  academicYearId  String
  /// Grades the students are in now (a Grade 9 student chooses Grade 10 courses for next year).
  gradeLevels     Int[]
  /// Open from opensAt (inclusive) until closesAt (exclusive).
  opensAt         DateTime
  closesAt        DateTime
  roundEn         String?
  roundAr         String?
  /// The closing deadline on the school calendar.
  calendarEventId String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId, academicYearId])
}

/// One student may change their choices until a time, outside the window. Reason required.
model CourseSelectionException {
  id             String    @id @default(cuid())
  orgId          String
  studentId      String
  academicYearId String
  until          DateTime
  reason         String
  grantedById    String
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  revokedById    String?

  @@index([orgId, studentId])
}

/// Choosing opened for one homeroom class for a short time (for example during a homeroom period).
model CourseSelectionSession {
  id             String    @id @default(cuid())
  orgId          String
  classId        String
  academicYearId String
  /// Short code for the link and QR code students scan.
  code           String
  startsAt       DateTime
  endsAt         DateTime
  startedById    String
  /// Set when the teacher ends it early.
  endedAt        DateTime?
  endedById      String?
  createdAt      DateTime  @default(now())

  @@unique([orgId, code])
  @@index([orgId, classId])
}

enum SelectionHelperKind {
  STAFF
  GUARDIAN
}

/// Someone allowed to make course choices for a student (assisted choosing). Selection data only.
model CourseSelectionHelper {
  id          String              @id @default(cuid())
  orgId       String
  studentId   String
  /// Membership of the teacher, counselor, advisor or guardian who may help.
  helperId    String
  kind        SelectionHelperKind
  until       DateTime
  reason      String?
  grantedById String
  /// The student allowed it themselves (false: a teacher or an admin did).
  byStudent   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  revokedAt   DateTime?
  revokedById String?

  @@index([orgId, studentId])
  @@index([orgId, helperId])
}

enum CourseSelectionStatus {
  /// Some choices saved, not submitted yet.
  DRAFT
  SUBMITTED
  SIGNED_OFF
}

/// Where a student's choices for a year stand, and who made and confirmed them.
model CourseSelectionSubmission {
  id             String                @id @default(cuid())
  orgId          String
  studentId      String
  academicYearId String
  status         CourseSelectionStatus @default(DRAFT)
  lastById       String?
  lastSource     RegistrationSource?
  /// Made by someone other than the student (a helper, a parent or staff).
  onBehalf       Boolean               @default(false)
  /// Changed by staff after the window closed.
  afterClose     Boolean               @default(false)
  lastAt         DateTime?
  submittedAt    DateTime?
  signedOffAt    DateTime?
  signedOffById  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([academicYearId, studentId])
  @@index([orgId, academicYearId])
}

// ---------------------------------------------------------------------------
// Grades
// ---------------------------------------------------------------------------

enum AssessmentKind {
  HOMEWORK
  QUIZ
  TEST
  EXAM
  PROJECT
  COURSEWORK
  PARTICIPATION
}

model Assessment {
  id            String         @id @default(cuid())
  orgId         String
  classId       String
  termId        String?
  titleEn       String
  titleAr       String
  kind          AssessmentKind @default(TEST)
  maxScore      Float          @default(100)
  weight        Float          @default(1)
  dueAt         DateTime?
  publishedAt   DateTime?
  /// Who published it (the teacher, or a grades.publish holder when the school uses a publisher).
  publishedById String?
  /// "Teachers submit, a publisher releases": the teacher marked the assessment ready for release.
  readyAt       DateTime?
  readyById     String?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  grades Grade[]

  @@index([orgId, classId])
  @@index([orgId, readyAt])
}

/// Who releases grades and report cards to families.
enum GradePublishMode {
  /// Teachers publish their own assessments (and report cards are visible when created).
  TEACHER
  /// Teachers mark work ready; holders of grades.publish release it.
  PUBLISHER
}

/// A school's grade publishing settings. Missing means TEACHER.
model GradeSettings {
  id          String           @id @default(cuid())
  orgId       String           @unique
  publishMode GradePublishMode @default(TEACHER)
  updatedById String?
  updatedAt   DateTime         @updatedAt
}

model Grade {
  id           String   @id @default(cuid())
  orgId        String
  assessmentId String
  studentId    String
  score        Float?
  excused      Boolean  @default(false)
  commentEn    String?
  commentAr    String?
  updatedById  String?
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([orgId, studentId])
}

/// Percentage bands that turn a score into a school grade (for example A* 90).
model GradeBand {
  id         String @id @default(cuid())
  orgId      String
  label      String
  minPercent Float
  sortOrder  Int    @default(0)

  @@unique([orgId, label])
}

// ---------------------------------------------------------------------------
// Trips and consent letters
// ---------------------------------------------------------------------------

enum TripStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TripConsent {
  PENDING
  GRANTED
  DECLINED
}

model Trip {
  id              String     @id @default(cuid())
  orgId           String
  titleEn         String
  titleAr         String
  descEn          String?
  descAr          String?
  destinationEn   String
  destinationAr   String
  startsAt        DateTime
  endsAt          DateTime
  costAed         Int?
  consentDeadline DateTime?
  status          TripStatus @default(DRAFT)
  gradeLevels     Int[]
  classIds        String[]
  organizerId     String
  templateKey     String?
  calendarEventId String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  participants TripParticipant[]

