  blurbAr      String
  homePath     String
  order        Int

  @@unique([orgId, key])
}

model JobRun {
  id             String    @id @default(cuid())
  orgId          String
  queue          String
  name           String
  idempotencyKey String
  status         JobStatus @default(RUNNING)
  result         Json?
  attempts       Int       @default(1)
  createdAt      DateTime  @default(now())
