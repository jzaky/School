// ---------------------------------------------------------------------------
// Global identity (no orgId)
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  passwordHash      String?
  nameEn            String
  nameAr            String?
  image             String?
  locale            Locale?
  lastActiveOrgId   String?
  isPlatformAdmin   Boolean   @default(false)
  /// Sessions opened before this moment are no longer valid (set when the password is reset).
  sessionsValidFrom DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts    Account[]
  memberships Membership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Organization and membership
// ---------------------------------------------------------------------------

model Organization {
  id                     String             @id @default(cuid())
  slug                   String             @unique
  nameEn                 String
  nameAr                 String
  shortNameEn            String?
  shortNameAr            String?
  isDemo                 Boolean            @default(false)
  defaultLocale          Locale             @default(en)
  timezone               String             @default("Asia/Dubai")
  currency               String             @default("AED")
  weekDays               Int[]              @default([1, 2, 3, 4, 5])
  regulator              Regulator          @default(KHDA)
  emirate                String             @default("Dubai")
  dataRegion             String             @default("me-central-1")
  hijriEnabled           Boolean            @default(false)
  numerals               Numerals           @default(WESTERN)
  aiEnabled              Boolean            @default(true)
  aiSensitiveDataEnabled Boolean            @default(false)
  aiProviderRegion       String             @default("global")
  emiratesIdPolicy       IdPolicy           @default(OPTIONAL)
  passportPolicy         IdPolicy           @default(OPTIONAL)
  crossBorderAllowed     Boolean            @default(false)
  primaryColor           String             @default("#0F4C81")
  accentColor            String             @default("#C8A24A")
  logoUrl                String?
  lastResetAt            DateTime?
  /// Modules switched on for this school (keys from src/lib/modules.ts). Empty means all defaults.
  enabledModules         String[]
  /// Curricula (tracks) this school teaches.
  curricula              SchoolCurriculum[]
  /// Setup wizard progress: completed step keys, and when setup was finished.
  onboardingSteps        String[]
  onboardingCompletedAt  DateTime?
  /// Who may join without a personal invite: staff with these email domains, families with the school code.
  staffEmailDomains      String[]
  staffDomainAutoApprove Boolean            @default(false)
  parentSelfJoin         Boolean            @default(true)
  parentJoinApproval     Boolean            @default(true)
  studentSelfJoin        Boolean            @default(false)
  joinCode               String?            @unique
  googleSignIn           Boolean            @default(true)
  microsoftSignIn        Boolean            @default(true)
  supportEmail           String?
  /// Notification kinds the school sends on WhatsApp to parents who opted in.
  whatsappKinds          String[]
  /// The school's own fee payment portal (https). Horizon never processes payments.
  feePaymentUrl          String?
  /// Who parents contact about fees (free text, for example an email address or phone number).
  feeContact             String?
  createdById            String?
  /// Code another school can use at sign-up (/signup?ref=CODE). Created on first view of the referral page.
  referralCode           String?            @unique
  /// The school whose referral code was used when this school signed up. Commercial terms are handled offline.
  referredByOrgId        String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  memberships Membership[]
  groupLink   SchoolGroupSchool?

  @@index([referredByOrgId])
}

model Membership {
  id           String           @id @default(cuid())
  orgId        String
  userId       String
  status       MembershipStatus @default(ACTIVE)
  titleEn      String?
  titleAr      String?
  locale       Locale?
  /// Last time this member used the app. Written at most once per 15 minutes (src/server/identity/last-active.ts).
  lastSeenAt   DateTime?
  /// Set when the person's data was erased or anonymised after a data subject request.
  anonymisedAt DateTime?
  createdAt    DateTime         @default(now())

  org          Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]
  staffProfile StaffProfile?
  student      Student?
  guardian     Guardian?

  @@unique([orgId, userId])
  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  orgId       String
  key         String
  nameEn      String
  nameAr      String
  descEn      String?
  descAr      String?
  permissions String[]
  isSystem    Boolean  @default(true)
  /// Set when a school edits a built-in role. Customized roles are never overwritten by deploys.
  customized  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  members MembershipRole[]

  @@unique([orgId, key])
}

model MembershipRole {
  id           String    @id @default(cuid())
  orgId        String
  membershipId String
  roleId       String
  /// End of a time-limited assignment (for example cover for the DSL during leave). Permission checks ignore
  /// it once passed and a daily worker job removes it (src/server/access/expiry.ts). Null: does not expire.
  expiresAt    DateTime?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([orgId])
  @@index([orgId, expiresAt])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// School structure
// ---------------------------------------------------------------------------

model Campus {
  id        String   @id @default(cuid())
  orgId     String
  nameEn    String
  nameAr    String
  addressEn String?
  addressAr String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  classes  SchoolClass[]
  students Student[]

  @@index([orgId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  orgId     String
  nameEn    String
  nameAr    String
  startsOn  DateTime
  endsOn    DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  terms   Term[]
  classes SchoolClass[]

  @@index([orgId])
}

model Term {
  id             String   @id @default(cuid())
  orgId          String
  academicYearId String
  nameEn         String
  nameAr         String
  startsOn       DateTime
  endsOn         DateTime

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Department {
  id               String   @id @default(cuid())
  orgId            String
  key              String
  nameEn           String
  nameAr           String
  headMembershipId String?
  createdAt        DateTime @default(now())

  subjects Subject[]
  staff    StaffProfile[]
  cases    Case[]

  @@unique([orgId, key])
}

model Subject {
  id           String   @id @default(cuid())
  orgId        String
  departmentId String?
  code         String
  nameEn       String
  nameAr       String
  createdAt    DateTime @default(now())

  department Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  classes    SchoolClass[]

  @@unique([orgId, code])
}

model SchoolClass {
  id                  String   @id @default(cuid())
  orgId               String
  academicYearId      String
  campusId            String?
  subjectId           String?
  teacherMembershipId String?
  nameEn              String
  nameAr              String
  gradeLevel          Int
  section             String?
  isHomeroom          Boolean  @default(false)
  room                String?
  capacity            Int?
  optionBlock         String?
  createdAt           DateTime @default(now())

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  subject      Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]

  @@index([orgId])
  @@index([teacherMembershipId])
}

model Enrollment {
  id        String       @id @default(cuid())
  orgId     String
  studentId String
  classId   String
  status    PersonStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([orgId])
  @@index([classId, status])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model StaffProfile {
  id           String   @id @default(cuid())
  orgId        String
  membershipId String   @unique
  departmentId String?
  employeeNo   String?
  jobTitleEn   String?
  jobTitleAr   String?
  phone        String?
  officeEn     String?
  officeAr     String?
  bioEn        String?
  bioAr        String?
  gradeLevels  Int[]
  createdAt    DateTime @default(now())

  membership Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([orgId])
}

model Student {
  id              String           @id @default(cuid())
  orgId           String
  membershipId    String?          @unique
  campusId        String?
  studentNo       String
  firstNameEn     String
  lastNameEn      String
  firstNameAr     String
  lastNameAr      String
  preferredName   String?
  gradeLevel      Int
  section         String?
  dateOfBirth     DateTime?
  gender          String?
  nationalityEn   String?
  nationalityAr   String?
  emiratesIdEnc   String?
  emiratesIdLast4 String?
  passportEnc     String?
  passportLast4   String?
  status          PersonStatus     @default(ACTIVE)
  enrolledOn      DateTime?
  houseEn         String?
  houseAr         String?
  curriculum      SchoolCurriculum @default(BRITISH)
  photoUrl        String?
  hasSen          Boolean          @default(false)
  /// Set when the student's personal data was anonymised after a deletion request.
  anonymisedAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  membership  Membership?            @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  campus      Campus?                @relation(fields: [campusId], references: [id], onDelete: SetNull)
  guardians   GuardianLink[]
  enrollments Enrollment[]
  medical     StudentMedical?
  attendance  AttendanceRecord[]
  cases       Case[]
  requests    Request[]
  careerProf  CareerProfile?
  assessments AptitudeAssessment[]
  recs        CareerRecommendation[]
  shortlist   ShortlistEntry[]

  @@unique([orgId, studentNo])
  @@index([orgId, gradeLevel])
}

model Guardian {
  id           String    @id @default(cuid())
  orgId        String
  membershipId String?   @unique
  firstNameEn  String
  lastNameEn   String
  firstNameAr  String
  lastNameAr   String
  email        String?
  phone        String?
  preferredLoc Locale    @default(en)
  occupation   String?
  /// Set when the guardian's personal data was anonymised after a deletion request.
  anonymisedAt DateTime?
  createdAt    DateTime  @default(now())

  membership Membership?    @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  links      GuardianLink[]

  @@index([orgId])
}

model GuardianLink {
  id              String  @id @default(cuid())
  orgId           String
  guardianId      String
  studentId       String
  relationshipEn  String  @default("Parent")
  relationshipAr  String  @default("ولي الأمر")
  isPrimary       Boolean @default(false)
  canApprove      Boolean @default(true)
  receivesUpdates Boolean @default(true)
  livesWith       Boolean @default(true)

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([orgId])
  @@index([studentId])
}

model StudentMedical {
  id             String   @id @default(cuid())
  orgId          String
  studentId      String   @unique
  allergiesEnc   String?
  conditionsEnc  String?
  medicationsEnc String?
  hasAlert       Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  orgId       String
  studentId   String
  date        DateTime         @db.Date
  status      AttendanceStatus
  minutesLate Int?
  /// REGISTER for marks taken in class; PARENT or STUDENT when the family reported the absence.
  source      AttendanceSource @default(REGISTER)
  /// The absence report (Request) that excused this day. Its reason stays on the request.
  requestId   String?
  /// The school's attendance code (AttendanceCode.code). Null on older rows: the status alone applies.
  code        String?
  /// Who last set the mark on a register (null for imports and absence reports).
  markedById  String?
  updatedAt   DateTime         @default(now()) @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([orgId, date])
}

// ---------------------------------------------------------------------------
// Attendance: codes, registers, lesson marks, follow-up and alerts (src/server/attendance)
// ---------------------------------------------------------------------------

/// How a code counts in attendance percentages.
enum AttendanceCountsAs {
  /// A possible session the student attended (present, late, approved school activity, remote learning).
  PRESENT
  /// A possible session the student missed (authorised or unauthorised).
  ABSENT
  /// Not a possible session (for example not required to attend). Left out of percentages.
  NOT_COUNTED
}

/// One attendance code of a school: what teachers and the office mark, and how it counts.
model AttendanceCode {
  id         String             @id @default(cuid())
  orgId      String
  /// Short code shown on registers, for example P, L, A, E.
  code       String
  labelEn    String
  labelAr    String
  countsAs   AttendanceCountsAs
  /// For absences: authorised (excused) or unauthorised.
  authorised Boolean            @default(false)
  /// Counts as a late arrival in lateness reports.
  late       Boolean            @default(false)
  /// Statistical category for reports (see src/server/attendance/codes.ts).
  category   String
  /// The code says why a student is away (for example illness). Only attendance.reasons holders see it;
  /// everyone else sees a plain excused absence.
  private    Boolean            @default(false)
  /// The one-tap button this code backs on registers: present, late, absent, excused or activity.
  quick      String?
  active     Boolean            @default(true)
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([orgId, code])
}

/// Who keeps the official register.
enum RegisterMode {
  /// Teachers take registers in Horizon; Horizon is the source of truth.
  HORIZON
  /// The school takes registers in another system; marks arrive through the API.
  EXTERNAL
}

/// A school's attendance settings. One row per school; missing means the defaults in src/server/attendance/settings.ts.
model AttendanceSettings {
  id                  String       @id @default(cuid())
  orgId               String       @unique
  mode                RegisterMode @default(HORIZON)
  /// Daily registration (morning register) starts at this local time, HH:MM.
  dailyStart          String       @default("07:30")
  /// Teachers may mark late for this many minutes after a register starts; later needs attendance.manage.
  lateCutoffMin       Int          @default(30)
  /// Registers close at this local time on the day; changes after closing need attendance.manage.
  closeTime           String       @default("15:30")
  /// Guardians of students absent without a report are contacted from this local time, HH:MM.
  followUpTime        String       @default("09:30")
  /// Send the unexplained absence message to guardians automatically.
  autoNotify          Boolean      @default(true)
  /// Persistent absence: alert when term-to-date attendance falls below this percentage.
  persistentThreshold Float        @default(90)
  /// Persistent absence: only after this many possible sessions in the term.
  persistentMinDays   Int          @default(10)
  /// Grade levels that take only a daily register (no per-lesson registers), for example KG.
  dailyOnlyGrades     Int[]        @default([-1, 0])
  /// Regulator absence limit (off by default). Sharjah (SPEA) preset: 10 consecutive or 15 total school days of
  /// unexcused absence in the academic year. Staff are alerted at limitWarnPct of either limit and on reaching it.
  limitEnabled        Boolean      @default(false)
  limitConsecutive    Int          @default(10)
  limitTotal          Int          @default(15)
  limitWarnPct        Int          @default(70)
  /// Heads of year: grade level (as text) to membership ids. They receive persistent absence alerts.
  headsOfYear         Json         @default("{}")
  updatedById         String?
  updatedAt           DateTime     @updatedAt
}

enum RegisterKind {
  /// Morning registration by homeroom. Its marks are the student's daily AttendanceRecord.
  DAILY
  /// One lesson from the timetable.
  LESSON
}

/// A register for one class on one date: the daily homeroom register (periodNo 0) or one lesson.
model AttendanceRegister {
  id         String       @id @default(cuid())
  orgId      String
  kind       RegisterKind
  classId    String
  date       DateTime     @db.Date
  /// 0 for the daily register, otherwise the bell period of the lesson.
  periodNo   Int          @default(0)
  slotId     String?
  /// Set when a cover teacher takes the register for this lesson.
  coverId    String?
  takenById  String?
  takenAt    DateTime?
  closedById String?
  closedAt   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  marks AttendanceLessonMark[]

  @@unique([classId, date, periodNo])
  @@index([orgId, date])
}

/// One student's mark on a lesson register. Daily marks live in AttendanceRecord.
model AttendanceLessonMark {
  id          String           @id @default(cuid())
  orgId       String
  registerId  String
  studentId   String
  date        DateTime         @db.Date
  code        String
  status      AttendanceStatus
  minutesLate Int?
  source      AttendanceSource @default(REGISTER)
  requestId   String?
  markedById  String?
  updatedAt   DateTime         @updatedAt

  register AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@unique([registerId, studentId])
  @@index([orgId, date])
  @@index([orgId, studentId, date])
}

enum FollowUpStatus {
  /// Absent without a report; nobody has reached the family yet.
  OPEN
  /// Staff have tried to reach the family (call or message), still unexplained.
  CONTACTED
  /// The absence is explained and recoded.
  EXPLAINED
}

/// One unexplained absence (a student, a day) for the attendance office. Also the idempotency anchor for the
/// automatic guardian message: one row per student and day, and the message is claimed by setting notifiedAt.
model AttendanceFollowUp {
  id            String         @id @default(cuid())
  orgId         String
  studentId     String
  date          DateTime       @db.Date
  status        FollowUpStatus @default(OPEN)
  /// When the automatic message to guardians was sent.
  notifiedAt    DateTime?
  /// Why no automatic message was sent: HELD (a wellbeing or safeguarding flag), OFF (school setting), NO_GUARDIAN.
  heldReason    String?
  explainedCode String?
  explainedById String?
  explainedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  contacts AttendanceContact[]

  @@unique([studentId, date])
  @@index([orgId, date, status])
}

/// The call and message log of a follow-up. Notes may hold what a family said; only the attendance office reads them.
model AttendanceContact {
  id         String   @id @default(cuid())
  orgId      String
  followUpId String
  /// CALL, MESSAGE, NOTE or AUTO_MESSAGE
  kind       String
  /// For calls: REACHED, NO_ANSWER or VOICEMAIL.
  outcome    String?
  note       String?
  /// Why staff messaged a family the school asked to contact by hand (rule 7 decision).
  reason     String?
  byId       String?
  createdAt  DateTime @default(now())

  followUp AttendanceFollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@index([orgId, followUpId])
}

/// An attendance alert to staff, never with reasons. One per student, period and kind: the unique key makes the
/// alert and its notifications idempotent.
/// - PERSISTENT: term-to-date attendance fell below the school's threshold (period: the term).
/// - LIMIT_WARNING / LIMIT_REACHED: unexcused absence neared or reached the regulator's limit (period: the year).
model AttendanceAlert {
  id          String    @id @default(cuid())
  orgId       String
  studentId   String
  kind        String    @default("PERSISTENT")
  periodId    String
  percent     Float?
  threshold   Float?
  possible    Int?
  /// Longest run of consecutive school days of unexcused absence, and the total, when the alert was raised.
  consecutive Int?
  total       Int?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@unique([studentId, periodId, kind])
  @@index([orgId, periodId])
}

